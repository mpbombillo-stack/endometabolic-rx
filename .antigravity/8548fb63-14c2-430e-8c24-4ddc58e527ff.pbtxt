          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque la glucosa en ayunas normal enmascara la hiperinsulinemia compensatoria hasta por 15 a\303\261os.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Correcto: El p\303\241ncreas hipersegrega insulina para mantener la normoglucemia. La elevaci\303\263n de insulina basal (8.6 \302\265IU/mL vs \303\263ptimo <5) revela la fricci\303\263n metab\303\263lica oculta.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
