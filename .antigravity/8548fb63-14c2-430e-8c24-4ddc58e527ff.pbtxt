          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Patr\303\263n Kraft III-A: Hiperinsulinemia con pico tard\303\255o patol\303\263gico (\"Diabetes In Situ\").\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Concluyente: El Dr. Joseph Kraft identific\303\263 el pico retrasado a los 120 min (>100 \302\265IU/mL) como la firma inequ\303\255voca de diabetes oculta previa a la elevaci\303\263n de glucosa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Patr\303\263n Kraft I: Respuesta insul\303\255nica eugluc\303\251mica conservada.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: En el patr\303\263n I el pico ocurre antes de los 60 min y a los 120 min la insulina es menor a 30 \302\265IU/mL.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
