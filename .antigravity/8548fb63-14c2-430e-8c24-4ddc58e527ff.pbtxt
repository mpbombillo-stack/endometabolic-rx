    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { FunctionalCareLogo } from \'./FunctionalCareLogo\';\n\ninterface AntigravityExportModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onShowToast: (msg: string) => void;\n}\n\nexport const AntigravityExportModal: React.FC<AntigravityExportModalProps> = ({\n  isOpen,\n  onClose,\n  onShowToast,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'bundle\' | \'config\' | \'runner\' | \'cli\'>(\'bundle\');\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen) return null;\n\n  const configJson = `{\n  \"$schema\": \"https://developer.google.com/genai/schemas/antigravity-agent.json\",\n  \"name\": \"EndoMetabolic Rx - Functional Care\",\n  \"version\": \"1.0.0\",\n  \"base_agent\": \"antigravity-preview-09-2026\",\n  \"environment\": {\n    \"type\": \"remote\",\n    \"runtime\": \"node22\",\n    \"ports\": [3000],\n    \"workdir\": \"/workspace\",\n    \"entrypoint\": \"npm run dev\",\n    \"sources\": [\n      {\n        \"type\": \"inline\",\n        \"target\": \".agents/AGENTS.md\"\n      }\n    ]\n  },\n  \"tools\": [\n    { \"type\": \"code_execution\" },\n    { \"type\": \"google_search\" },\n    { \"type\": \"url_context\" }\n  ],\n  \"system_instruction\": \"You are the clinical engineer executing the EndoMetabolic Rx Functional Medicine platform. Follow the instructions in .agents/AGENTS.md, maintain TypeScript safety without any mock regressions, ensure FHIR R4 standard compliance, and serve the application on port 3000.\"\n}`;\n\n  const runnerCode = `/**\n * Antigravity Agent Invocation Script\n * Utiliza @google/genai Interactions API con antigravity-preview-09-2026\n */\nimport { GoogleGenAI } from \'@google/genai\';\n\nasync function runAntigravity() {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey) {\n    throw new Error(\'GEMINI_API_KEY no encontrada en las variables de entorno.\');\n  }\n\n  const ai = new GoogleGenAI({ apiKey });\n\n  console.log(\'\360\237\232\200 Inicializando Antigravity Agent (antigravity-preview-09-2026)...\');\n\n  const interaction = await ai.interactions.create(\n    {\n      agent: \'antigravity-preview-09-2026\',\n      input: \n        \'Despliega y verifica EndoMetabolic Rx - Functional Care en el sandbox Linux. \' +\n        \'Ejecuta \"npm run build\" y \"npm run lint\", y valida las 7 pantallas cl\303\255nicas y el desaf\303\255o de 10 niveles.\',\n      environment: \'remote\',\n      tools: [\n        { type: \'code_execution\' },\n        { type: \'google_search\' },\n        { type: \'url_context\' }\n      ]\n    },\n    { timeout: 300000 }\n  );\n\n  console.log(\\`\360\237\223\246 Sandbox Environment ID: \\${interaction.environment_id}\\`);\n  console.log(\\`\360\237\223\212 Estado de ejecuci\303\263n: \\${interaction.status}\\`);\n\n  // Extraer respuesta multi-step de Antigravity\n  let fullOutput = \'\';\n  for (const step of interaction.steps || []) {\n    if (step.type === \'model_output\') {\n      const textPart = step.content?.find((c: any) => c.type === \'text\');\n      if (textPart?.text) fullOutput += textPart.text;\n    }\n  }\n\n  console.log(\'--- Salida del Agente Antigravity ---\');\n  console.log(fullOutput || interaction.output_text);\n}\n\nrunAntigravity().catch(console.error);`;\n\n  const bundlePreviewJson = `{\n  \"$schema\": \"https://developer.google.com/genai/schemas/antigravity-agent.json\",\n  \"id\": \"endometabolic-rx-functional-care\",\n  \"name\": \"EndoMetabolic Rx - Functional Care CDSS\",\n  \"version\": \"1.0.0\",\n  \"base_agent\": \"antigravity-preview-09-2026\",\n  \"metadata\": {\n    \"exported_at\": \"${new Date().toISOString()}\",\n    \"file_count\": 31,\n    \"platform\": \"Google GenAI Antigravity Managed Agent\"\n  },\n  \"system_instruction\": \"Eres el agente cl\303\255nico e ingeniero de software responsable de EndoMetabolic Rx - Functional Care...\",\n  \"base_environment\": {\n    \"type\": \"remote\",\n    \"runtime\": \"node22\",\n    \"workdir\": \"/workspace\",\n    \"ports\": [3000],\n    \"entrypoint\": \"npm run dev\",\n    \"sources\": [\n      { \"type\": \"inline\", \"target\": \"/.agents/AGENTS.md\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/package.json\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/src/App.tsx\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/src/screens/AtmScreen.tsx\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/src/screens/ClinicalGameScreen.tsx\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/src/components/FunctionalCareLogo.tsx\", \"content\": \"...\" },\n      { \"type\": \"inline\", \"target\": \"/src/utils/metabolicCalculators.ts\", \"content\": \"...\" }\n      /* ... 31 archivos de c\303\263digo fuente empaquetados */\n    ]\n  },\n  \"tools\": [\n    { \"type\": \"code_execution\" },\n    { \"type\": \"google_search\" },\n    { \"type\": \"url_context\" }\n  ]\n}`;\n\n  const handleCopy = (text: string, label: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    onShowToast(`Copiado: ${label}`);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleDownload = (filename: string, content: string) => {\n    const blob = new Blob([content], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = filename;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    onShowToast(`Archivo descargado: ${filename}`);\n  };\n\n  const getCurrentContent = () => {\n    switch (activeTab) {\n      case \'bundle\':\n        return bundlePreviewJson;\n      case \'config\':\n        return configJson;\n      case \'runner\':\n        return runnerCode;\n      case \'cli\':\n        return `# 1. Empaquetar todo el c\303\263digo para Antigravity\nnpm run export:antigravity\n\n# 2. Ejecutar la invocaci\303\263n remota del Antigravity Agent\nnpm run antigravity:run\n\n# 3. Invocaci\303\263n manual directa con tsx\nnpx tsx scripts/antigravity-runner.ts\n\n# 4. Creaci\303\263n de Agente Personalizado con la SDK @google/genai:\n# import { GoogleGenAI } from \'@google/genai\';\n# const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n# const bundle = JSON.parse(fs.readFileSync(\'antigravity-bundle.json\', \'utf8\'));\n# const agent = await ai.agents.create(bundle);\n# console.log(\'Agente registrado en Google AI Studio:\', agent.id);`;\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4 animate-in fade-in duration-200\">\n      <div className=\"bg-[#0b1716] border border-[#1b3d39] rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden\">\n        {/* Modal Header */}\n        <div className=\"p-5 border-b border-[#1b3d39] bg-[#071110] flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <FunctionalCareLogo variant=\"emblem\" height={38} theme=\"colored\" />\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-lg font-bold text-[#e1e3e2] tracking-wide\">\n                  Exportaci\303\263n para Google Antigravity Agent\n                </h3>\n                <span className=\"bg-[#183431] text-[#71d9cc] border border-[#2b5953] px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-semibold\">\n                  antigravity-preview-09-2026\n                </span>\n              </div>\n              <p className=\"text-xs text-[#859491] mt-0.5\">\n                C\303\263digo fuente completo empaquetado para ejecuci\303\263n en el sandbox remoto de Google GenAI\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-[#859491] hover:text-white p-2 rounded-lg hover:bg-[#152a28] transition-colors cursor-pointer\"\n            title=\"Cerrar modal\"\n          >\n            <span className=\"material-symbols-outlined text-xl\">close</span>\n          </button>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex border-b border-[#1b3d39] bg-[#0c1d1b] px-5 gap-2 pt-2\">\n          <button\n            onClick={() => setActiveTab(\'bundle\')}\n            className={`px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-2 cursor-pointer ${\n              activeTab === \'bundle\'\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-sm\">inventory_2</span>\n            Bundle Completo (antigravity-bundle.json)\n          </button>\n          <button\n            onClick={() => setActiveTab(\'config\')}\n            className={`px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-2 cursor-pointer ${\n              activeTab === \'config\'\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-sm\">settings_suggest</span>\n            Configuraci\303\263n (antigravity.config.json)\n          </button>\n          <button\n            onClick={() => setActiveTab(\'runner\')}\n            className={`px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-2 cursor-pointer ${\n              activeTab === \'runner\'\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-sm\">terminal</span>\n            Runner Script (@google/genai)\n          </button>\n          <button\n            onClick={() => setActiveTab(\'cli\')}\n            className={`px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-2 cursor-pointer ${\n              activeTab === \'cli\'\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-sm\">code</span>\n            Comandos Terminal\n          </button>\n        </div>\n\n        {/* Content Area */}\n        <div className=\"flex-1 p-5 overflow-y-auto bg-[#081211]\">\n          {/* Metadata Card */}\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3 mb-4 text-xs\">\n            <div className=\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\">\n              <span className=\"text-[#859491] block text-[10px] uppercase font-mono\">Agente Base</span>\n              <span className=\"font-bold text-[#e1e3e2]\">antigravity-preview-09-2026</span>\n            </div>\n            <div className=\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\">\n              <span className=\"text-[#859491] block text-[10px] uppercase font-mono\">Archivos Empaquetados</span>\n              <span className=\"font-bold text-[#71d9cc]\">31 Archivos de C\303\263digo</span>\n            </div>\n            <div className=\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\">\n              <span className=\"text-[#859491] block text-[10px] uppercase font-mono\">Entorno Sandbox</span>\n              <span className=\"font-bold text-[#e1e3e2]\">Linux Node 22 / Port 3000</span>\n            </div>\n            <div className=\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\">\n              <span className=\"text-[#859491] block text-[10px] uppercase font-mono\">Herramientas Sandbox</span>\n              <span className=\"font-bold text-[#fe932c]\">Code Execution \342\200\242 Search</span>\n            </div>\n          </div>\n\n          {/* Code Viewer */}\n          <div className=\"relative rounded-xl overflow-hidden border border-[#1b3d39] bg-[#050c0c]\">\n            <div className=\"flex items-center justify-between px-4 py-2 bg-[#091514] border-b border-[#1b3d39] text-xs\">\n              <span className=\"font-mono text-[#859491]\">\n                {activeTab === \'bundle\'\n                  ? \'antigravity-bundle.json\'\n                  : activeTab === \'config\'\n                  ? \'antigravity.config.json\'\n                  : activeTab === \'runner\'\n                  ? \'scripts/antigravity-runner.ts\'\n                  : \'Instrucciones CLI\'}\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => handleCopy(getCurrentContent(), activeTab)}\n                  className=\"px-3 py-1 bg-[#142d2a] hover:bg-[#1d433f] text-[#a3faef] border border-[#2b5953] rounded text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer\"\n                >\n                  <span className=\"material-symbols-outlined text-sm\">\n                    {copied ? \'check\' : \'content_copy\'}\n                  </span>\n                  {copied ? \'Copiado\' : \'Copiar\'}\n                </button>\n                {activeTab !== \'cli\' && (\n                  <button\n                    onClick={() =>\n                      handleDownload(\n                        activeTab === \'bundle\'\n                          ? \'antigravity-bundle.json\'\n                          : activeTab === \'config\'\n                          ? \'antigravity.config.json\'\n                          : \'antigravity-runner.ts\',\n                        getCurrentContent()\n                      )\n                    }\n                    className=\"px-3 py-1 bg-[#005c55] hover:bg-[#0f766e] text-white rounded text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    <span className=\"material-symbols-outlined text-sm\">download</span>\n                    Descargar\n                  </button>\n                )}\n              </div>\n            </div>\n            <pre className=\"p-4 text-xs font-mono text-[#c4d6d3] overflow-x-auto max-h-[380px] leading-relaxed selection:bg-[#005c55] selection:text-white\">\n              <code>{getCurrentContent()}</code>\n            </pre>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 border-t border-[#1b3d39] bg-[#071110] flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2 text-[#859491]\">\n            <span className=\"material-symbols-outlined text-base text-[#71d9cc]\">verified</span>\n            <span>\n              Configurado seg\303\272n las especificaciones de Google GenAI Interactions API (v2.4+)\n            </span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2 bg-[#1b3d39] hover:bg-[#285751] text-white rounded-lg font-semibold transition-colors cursor-pointer\"\n          >\n            Entendido\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
