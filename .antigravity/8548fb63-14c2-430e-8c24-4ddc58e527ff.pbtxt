= \'surrogate-indices\' && (\\n            <SurrogateIndicesScreen\\n              labs={patientLabs}\\n              onUpdateLabs={(newLabs) => setPatientLabs(newLabs)}\\n              onShowToast={showToast}\\n              onOpenFhir={() => setIsFhirModalOpen(true)}\\n            />\\n          )}\\n\\n          {currentTab === \'kraft-ogtt-curves\' && (\\n            <KraftOgttScreen\\n              onOpenFhir={() => setIsFhirModalOpen(true)}\\n              onShowToast={showToast}\\n            />\\n          )}\\n\\n          {currentTab === \'cdss-stratification\' && (\\n            <CdssScreen\\n              onOpenFhir={() => setIsFhirModalOpen(true)}\\n              onShowToast={showToast}\\n            />\\n          )}\\n\\n          {currentTab === \'therapeutics-matrix\' && (\\n            <TherapeuticsScreen\\n              onShowToast={showToast}\\n              onOpenFhir={() => setIsFhirModalOpen(true)}\\n            />\\n          )}\\n\\n          {currentTab === \'monitoring-fhir\' && (\\n            <MonitoringFhirScreen\\n              onShowToast={showToast}\\n              onOpenFhir={() => setIsFhirModalOpen(true)}\\n            />\\n          )}\\n\\n          {currentTab === \'clinical-game\' && (\\n            <ClinicalGameScreen\\n              onShowToast={showToast}\\n              gameScore={gameScore}\\n              onUpdateScore={(newScore) => setGameScore(newScore)}\\n              currentLevelNumber={gameLevelNumber}\\n              onUpdateLevel={(lvl) => setGameLevelNumber(lvl)}\\n            />\\n          )}\\n        </main>\\n      </div>\\n\\n      {/* FHIR R4 Modal */}\\n      <FhirModal\\n        isOpen={isFhirModalOpen}\\n        onClose={() => setIsFhirModalOpen(false)}\\n        labs={patientLabs}\\n        patientName=\\\"Eleanor Vance\\\"\\n        homaIr={surrogates.homaIr}\\n        onShowToast={showToast}\\n      />\\n\\n      {/* Matrix Node Clinical Deep Inspector Modal */}\\n      <InspectorModal\\n        node={inspectorNode}\\n        onClose={() => setInspectorNode(null)}\\n        onApplyProtocol={handleApplyProtocol}\\n      />\\n\\n      {/* Floating Feedback Toast */}\\n      <Toast message={toastMessage} onClose={() => setToastMessage(null)} />\\n    </div>\\n  );\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Writing App.tsx\", \"toolSummary\":\"Implement App with all screens and state management\"}"
