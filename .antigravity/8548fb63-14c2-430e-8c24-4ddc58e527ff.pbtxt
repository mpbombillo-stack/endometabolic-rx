        }
        lines {
          text: "        prompt: \'\302\277Qu\303\251 porcentaje de la glucosa postprandial es captada normalmente por el tejido muscular esquel\303\251tico?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
