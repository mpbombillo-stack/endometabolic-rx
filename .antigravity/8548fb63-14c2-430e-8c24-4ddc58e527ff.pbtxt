          text: "        options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque las c\303\251lulas beta pancre\303\241ticas sufrieron agotamiento funcional y apoptosis por estr\303\251s de ret\303\255culo endopl\303\241smico sostenido (Patr\303\263n Kraft V).\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Magistral: El p\303\241ncreas ya no puede sostener la hiperproducci\303\263n compensatoria. La glucolipotoxicidad destruye la masa funcional de c\303\251lulas beta, transitando a diabetes insulinop\303\251nica secundaria.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque el paciente se cur\303\263 espont\303\241neamente de la resistencia a la insulina.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: Una insulina baja con hiperglucemia es signo de claudicaci\303\263n pancre\303\241tica terminal, no de recuperaci\303\263n.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
