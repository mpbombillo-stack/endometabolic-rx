      name: "create_file"
      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { GAME_LEVELS } from \'../data/gameLevelsData\';\\nimport { KRAFT_PATTERNS_MAP } from \'../utils/metabolicCalculators\';\\nimport { GameLevel } from \'../types\';\\n\\ninterface ClinicalGameScreenProps {\\n  onShowToast: (msg: string) => void;\\n  gameScore: number;\\n  onUpdateScore: (newScore: number) => void;\\n  currentLevelNumber: number;\\n  onUpdateLevel: (level: number) => void;\\n}\\n\\nexport const ClinicalGameScreen: React.FC<ClinicalGameScreenProps> = ({\\n  onShowToast,\\n  gameScore,\\n  onUpdateScore,\\n  currentLevelNumber,\\n  onUpdateLevel,\\n}) => {\\n  const [selectedLevelId, setSelectedLevelId] = useState<number>(currentLevelNumber || 1);\\n  const [currentQuestionIndex, setCurrentQuestionIndex] = useState<number>(0);\\n  const [selectedOptionIndex, setSelectedOptionIndex] = useState<number | null>(null);\\n  const [showExplanation, setShowExplanation] = useState<boolean>(false);\\n  const [levelStars, setLevelStars] = useState<Record<number, number>>({ 1: 3 });\\n  const [comboStreak, setComboStreak] = useState<number>(0);\\n\\n  const level: GameLevel = GAME_LEVELS.find((l) => l.id === selectedLevelId) || GAME_LEVELS[0];\\n  const question = level.questions[currentQuestionIndex] || level.questions[0];\\n  const patternInfo = KRAFT_PATTERNS_MAP[level.kraftPattern] || KRAFT_PATTERNS_MAP[\'pattern-2\'];\\n\\n  const handleSelectOption = (index: number) => {\\n    if (showExplanation) return;\\n    setSelectedOptionIndex(index);\\n    setShowExplanation(true);\\n\\n    const isCorrect = question.options[index]?.correct;\\n    if (isCorrect) {\\n      const addedPoints = 100 + comboStreak * 25;\\n      const newScore = gameScore + addedPoints;\\n      onUpdateScore(newScore);\\n      setComboStreak((c) => c + 1);\\n      onShowToast(`\302\241Diagn\303\263stico Correcto! +${addedPoints} pts \360\237\216\257`);\\n    } else {\\n      setComboStreak(0);\\n      onShowToast(\'Diagn\303\263stico incorrecto. Revisa el fundamento cl\303\255nico.\');\\n    }\\n  };\\n\\n  const handleNextQuestion = () => {\\n    if (currentQuestionIndex < level.questions.length - 1) {\\n      setCurrentQuestionIndex((prev) => prev + 1);\\n      setSelectedOptionIndex(null);\\n      setShowExplanation(false);\\n    } else {\\n      // Level completed!\\n      const starsEarned = 3;\\n      setLevelStars((prev) => ({\\n        ...prev,\\n        [level.id]: Math.max(prev[level.id] || 0, starsEarned),\\n        // Unlock next level\\n        [level.id + 1]: prev[level.id + 1] || 0,\\n      }));\\n      onShowToast(`\302\241Nivel ${level.levelNumber} Completado con \303\211xito! \360\237\217\206`);\\n\\n      if (level.levelNumber < 10) {\\n        onUpdateLevel(level.levelNumber + 1);\\n        setSelectedLevelId(level.levelNumber + 1);\\n        setCurrentQuestionIndex(0);\\n        setSelectedOptionIndex(null);\\n        setShowExplanation(false);\\n      }\\n    }\\n  };\\n\\n  const selectLevel = (lvlId: number) => {\\n    setSelectedLevelId(lvlId);\\n    setCurrentQuestionIndex(0);\\n    setSelectedOptionIndex(null);\\n    setShowExplanation(false);\\n  };\\n\\n  return (\\n    <div className=\\\"flex flex-col w-full gap-6\\\">\\n      {/* Eye-catching Modern Game Header */}\\n      <section className=\\\"w-full bg-gradient-to-r from-[#005c55] via-[#0f766e] to-[#904d00] rounded-2xl p-5 md:p-6 shadow-md text-white flex flex-col lg:flex-row lg:items-center justify-between gap-4 relative overflow-hidden\\\">\\n        <div className=\\\"absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-white/10 blur-2xl pointer-events-none\\\" />\\n        <div className=\\\"flex flex-col gap-1 z-10\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"px-2.5 py-0.5 rounded-full bg-white/20 text-[11px] font-bold uppercase tracking-wider backdrop-blur-sm\\\">\\n              SIMULADOR CL\303\215NICO INTERACTIVO\\n            </span>\\n            <span className=\\\"text-[12px] text-[#9cf2e8] flex items-center gap-1 font-semibold\\\">\\n              <span className=\\\"material-symbols-outlined text-[16px] animate-spin\\\">autorenew</span>\\n              10 Niveles de Complejidad Progresiva\\n            </span>\\n          </div>\\n          <h1 className=\\\"text-[24px] md:text-[26px] font-black tracking-tight mt-0.5\\\">\\n            Desaf\303\255o Cl\303\255nico: Maestro en Fenotipos Metab\303\263licos y Curvas Kraft\\n          </h1>\\n          <p className=\\\"text-[13px] text-white/90 max-w-2xl leading-relaxed\\\">\\n            Resuelve casos cl\303\255nicos de pacientes reales. Diagnostica patrones de insulina Kraft, identifica mediadores de la matriz ATM y selecciona la directiva de intervenci\303\263n adecuada para desbloquear el siguiente nivel.\\n          </p>\\n        </div>\\n\\n        {/* Score & Combo HUD */}\\n        <div className=\\\"flex items-center gap-3 z-10 self-start lg:self-center\\\">\\n          <div className=\\\"flex flex-col items-end px-4 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20\\\">\\n            <span className=\\\"text-[10px] text-white/80 uppercase font-semibold\\\">Puntuaci\303\263n Total</span>\\n            <span className=\\\"text-[26px] font-black tracking-tight tabular-nums text-[#fe932c]\\\">\\n              {gameScore} <span className=\\\"text-[12px] font-bold text-white\\\">pts</span>\\n            </span>\\n          </div>\\n          <div className=\\\"flex flex-col items-center px-3 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/20\\\">\\n            <span className=\\\"text-[10px] text-white/80 uppercase font-semibold\\\">Racha Combo</span>\\n            <span className=\\\"text-[20px] font-black text-[#80d5cb] flex items-center gap-0.5\\\">\\n              \360\237\224\245 x{comboStreak}\\n            </span>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 10 Levels Roadmap Ribbon */}\\n      <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col gap-2\\\">\\n        <div className=\\\"flex items-center justify-between text-[12px]\\\">\\n          <span className=\\\"font-bold text-[#1e1b19] flex items-center gap-1.5\\\">\\n            <span className=\\\"material-symbols-outlined text-[#005c55] text-[18px]\\\">map</span>\\n            Mapa de los 10 Niveles Cl\303\255nicos\\n          </span>\\n          <span className=\\\"text-[#6e7977]\\\">\\n            Nivel Activo: <strong className=\\\"text-[#005c55]\\\">{selectedLevelId}/10</strong>\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-5 lg:grid-cols-10 gap-2 pt-1\\\">\\n          {GAME_LEVELS.map((lvl) => {\\n            const isSelected = lvl.id === selectedLevelId;\\n            const stars = levelStars[lvl.id] ?? 0;\\n            const isUnlocked = lvl.id === 1 || levelStars[lvl.id] !== undefined || lvl.id <= currentLevelNumber;\\n\\n            return (\\n              <button\\n                key={lvl.id}\\n                disabled={!isUnlocked}\\n                onClick={() => selectLevel(lvl.id)}\\n                className={`p-2.5 rounded-lg flex flex-col items-center justify-between text-center transition-all cursor-pointer border ${\\n                  isSelected\\n                    ? \'bg-[#005c55] text-white border-[#005c55] ring-2 ring-[#005c55]/30 shadow-md\'\\n                    : isUnlocked\\n                    ? \'bg-[#faf2ee] hover:bg-[#f4ece8] text-[#1e1b19] border-[#e9e1dd]\'\\n                    : \'bg-[#eee7e3]/60 text-[#bdc9c6] border-transparent cursor-not-allowed\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between w-full text-[10px]\\\">\\n                  <span className=\\\"font-bold\\\">L{lvl.levelNumber}</span>\\n                  {isUnlocked ? (\\n                    <span className=\\\"text-[#fe932c] text-[10px]\\\">\\n                      {\'\342\230\205\'.repeat(stars || 1)}\\n                    </span>\\n                  ) : (\\n                    <span className=\\\"material-symbols-outlined text-[12px]\\\">lock</span>\\n                  )}\\n                </div>\\n                <span className=\\\"text-[11px] font-bold line-clamp-1 my-1\\\">\\n                  {lvl.title.split(\' \')[0]}\\n                </span>\\n                <span\\n                  className={`text-[9px] px-1 rounded ${\\n                    isSelected\\n                      ? \'bg-white/20 text-white\'\\n                      : \'bg-[#e9e1dd] text-[#3e4947]\'\\n                  }`}\\n                >\\n                  {lvl.difficulty}\\n                </span>\\n              </button>\\n            );\\n          })}\\n        </div>\\n      </div>\\n\\n      {/* Main Challenge Arena: Case Presentation (5 cols) + Question & Diagnostic Matrix (7 cols) */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Left Column: Patient Case Profile (5 cols) */}\\n        <div className=\\\"lg:col-span-5 flex flex-col gap-4\\\">\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col gap-3\\\">\\n            <div className=\\\"flex items-center justify-between pb-2 border-b border-[#eee7e3]\\\">\\n              <div>\\n                <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-[#904d00]\\\">\\n                  Caso Cl\303\255nico \342\200\242 Nivel {level.levelNumber} de 10\\n                </span>\\n                <h3 className=\\\"text-[18px] font-bold text-[#1e1b19]\\\">{level.patient.name}</h3>\\n              </div>\\n              <span className=\\\"px-2 py-0.5 rounded-full bg-[#005c55]/10 text-[#005c55] text-[11px] font-bold\\\">\\n                {level.difficulty}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"text-[12px] text-[#3e4947] space-y-1\\\">\\n              <div>\\n                <strong>Datos:</strong> {level.patient.age} a\303\261os \342\200\242 {level.patient.sex === \'F\' ? \'Femenino\' : \'Masculino\'} \342\200\242 {level.patient.occupation}\\n              </div>\\n              <div className=\\\"p-2.5 rounded-lg bg-[#faf2ee] border border-[#eee7e3] text-[12px] text-[#1e1b19]\\\">\\n                <strong>Motivo de consulta y s\303\255ntomas:</strong> {level.patient.symptoms}\\n              </div>\\n            </div>\\n\\n            {/* Patient Lab Snapshot */}\\n            <div className=\\\"mt-1\\\">\\n              <span className=\\\"text-[11px] font-bold text-[#1e1b19] uppercase tracking-wider block mb-1.5\\\">\\n                Panel de Laboratorio en Ayunas:\\n              </span>\\n              <div className=\\\"grid grid-cols-2 gap-2 text-[12px]\\\">\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Glucosa:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">{level.labs.glucoseFasting} mg/dL</strong>\\n                </div>\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Insulina:</span>\\n                  <strong className=\\\"text-[#904d00]\\\">{level.labs.insulinFasting} \316\274IU/mL</strong>\\n                </div>\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Triglic\303\251ridos:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">{level.labs.triglycerides} mg/dL</strong>\\n                </div>\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">HDL:</span>\\n                  <strong className=\\\"text-[#005c55]\\\">{level.labs.hdl} mg/dL</strong>\\n                </div>\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">IMC:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">{level.labs.bmi} kg/m\302\262</strong>\\n                </div>\\n                <div className=\\\"p-2 rounded bg-[#faf2ee] border border-[#eee7e3] flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Cintura:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">{level.labs.waistCm} cm</strong>\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Kraft Curve Mini Viewer for This Case */}\\n            <div className=\\\"mt-2 p-3 rounded-lg bg-[#faf2ee] border border-[#eee7e3]\\\">\\n              <div className=\\\"flex items-center justify-between text-[11px] mb-1 font-semibold\\\">\\n                <span className=\\\"text-[#005c55]\\\">Cinetica Kraft (0-180 min):</span>\\n                <span className=\\\"text-[#904d00]\\\">{patternInfo.badge}</span>\\n              </div>\\n              <div className=\\\"w-full h-24 relative bg-white rounded border border-[#e9e1dd] overflow-hidden\\\">\\n                <svg className=\\\"w-full h-full\\\" preserveAspectRatio=\\\"none\\\" viewBox=\\\"0 0 400 120\\\">\\n                  <path d={patternInfo.insulinArea} fill=\\\"#fe932c\\\" fillOpacity=\\\"0.25\\\" />\\n                  <path d={patternInfo.insulinPath} fill=\\\"none\\\" stroke=\\\"#904d00\\\" strokeWidth=\\\"2.5\\\" />\\n                  <path d={patternInfo.glucosePath} fill=\\\"none\\\" stroke=\\\"#005c55\\\" strokeWidth=\\\"2\\\" strokeDasharray=\\\"3,3\\\" />\\n                </svg>\\n              </div>\\n              <div className=\\\"flex justify-between text-[10px] text-[#6e7977] mt-1\\\">\\n                <span>0m: {patternInfo.points[0].gluc}/{patternInfo.points[0].ins}</span>\\n                <span>60m: {patternInfo.points[2].gluc}/{patternInfo.points[2].ins}</span>\\n                <span>120m: {patternInfo.points[3].gluc}/{patternInfo.points[3].ins}</span>\\n                <span>180m: {patternInfo.points[4].gluc}/{patternInfo.points[4].ins}</span>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Right Column: Challenge Interactive Question (7 cols) */}\\n        <div className=\\\"lg:col-span-7 flex flex-col gap-4\\\">\\n          <div className=\\\"bg-[#ffffff] p-5 md:p-6 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col justify-between min-h-[480px]\\\">\\n            <div>\\n              {/* Question Stepper */}\\n              <div className=\\\"flex items-center justify-between pb-3 border-b border-[#eee7e3]\\\">\\n                <span className=\\\"text-[11px] font-bold uppercase tracking-wider text-[#005c55]\\\">\\n                  Pregunta {currentQuestionIndex + 1} de {level.questions.length}\\n                </span>\\n                <div className=\\\"flex items-center gap-1\\\">\\n                  {level.questions.map((_, qIdx) => (\\n                    <span\\n                      key={qIdx}\\n                      className={`w-2.5 h-2.5 rounded-full ${\\n                        qIdx === currentQuestionIndex\\n                          ? \'bg-[#005c55]\'\\n                          : qIdx < currentQuestionIndex\\n                          ? \'bg-[#80d5cb]\'\\n                          : \'bg-[#eee7e3]\'\\n                      }`}\\n                    />\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Prompt */}\\n              <h3 className=\\\"text-[16px] md:text-[17px] font-bold text-[#1e1b19] mt-3 leading-snug\\\">\\n                {question.prompt}\\n              </h3>\\n\\n              {/* Options */}\\n              <div className=\\\"flex flex-col gap-2.5 mt-4\\\">\\n                {question.options.map((option, idx) => {\\n                  const isSelected = selectedOptionIndex === idx;\\n                  let optionStyles = \'bg-[#faf2ee] hover:bg-[#f4ece8] border-[#e9e1dd] text-[#1e1b19]\';\\n\\n                  if (showExplanation) {\\n                    if (option.correct) {\\n                      optionStyles = \'bg-[#005c55]/15 border-[#005c55] text-[#005c55] font-bold\';\\n                    } else if (isSelected && !option.correct) {\\n                      optionStyles = \'bg-[#cb2044]/15 border-[#cb2044] text-[#cb2044]\';\\n                    } else {\\n                      optionStyles = \'bg-[#faf2ee] opacity-50 border-[#eee7e3]\';\\n                    }\\n                  }\\n\\n                  return (\\n                    <button\\n                      key={idx}\\n                      disabled={showExplanation}\\n                      onClick={() => handleSelectOption(idx)}\\n                      className={`p-3.5 rounded-xl border text-left text-[13px] transition-all flex items-start gap-3 cursor-pointer ${optionStyles}`}\\n                    >\\n                      <span className=\\\"w-6 h-6 rounded-full bg-white/80 border border-current flex items-center justify-center shrink-0 text-[11px] font-bold mt-0.5\\\">\\n                        {String.fromCharCode(65 + idx)}\\n                      </span>\\n                      <span className=\\\"leading-snug\\\">{option.text}</span>\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* Clinical Explanation Card */}\\n              {showExplanation && (\\n                <div\\n                  className={`mt-4 p-4 rounded-xl border text-[12.5px] leading-relaxed animate-in fade-in duration-200 ${\\n                    question.options[selectedOptionIndex ?? 0]?.correct\\n                      ? \'bg-[#005c55]/10 border-[#005c55]/30 text-[#005c55]\'\\n                      : \'bg-[#cb2044]/10 border-[#cb2044]/30 text-[#40000d]\'\\n                  }`}\\n                >\\n                  <div className=\\\"font-bold flex items-center gap-1.5 mb-1 text-[13px]\\\">\\n                    <span className=\\\"material-symbols-outlined text-[18px]\\\">\\n                      {question.options[selectedOptionIndex ?? 0]?.correct\\n                        ? \'check_circle\'\\n                        : \'cancel\'}\\n                    </span>\\n                    <span>\\n                      {question.options[selectedOptionIndex ?? 0]?.correct\\n                        ? \'\302\241Excelente Razonamiento Cl\303\255nico!\'\\n                        : \'Fundamento Patol\303\263gico:\'}\\n                    </span>\\n                  </div>\\n                  <p>\\n                    {question.options[selectedOptionIndex ?? 0]?.explanation ||\\n                      question.options.find((o) => o.correct)?.explanation}\\n                  </p>\\n                </div>\\n              )}\\n            </div>\\n\\n            {/* Next / Continue Action */}\\n            {showExplanation && (\\n              <div className=\\\"mt-5 pt-3 border-t border-[#eee7e3] flex justify-end\\\">\\n                <button\\n                  onClick={handleNextQuestion}\\n                  className=\\\"px-5 py-2.5 rounded-lg bg-[#005c55] hover:bg-[#0f766e] text-white text-[13px] font-bold shadow-md transition-all flex items-center gap-2 cursor-pointer\\\"\\n                >\\n                  <span>\\n                    {currentQuestionIndex < level.questions.length - 1\\n                      ? \'Siguiente Pregunta\'\\n                      : level.levelNumber < 10\\n                      ? \'Completar Nivel y Avanzar al Nivel \' + (level.levelNumber + 1)\\n                      : \'\302\241Felicidades! Has Dominado los 10 Niveles\'}\\n                  </span>\\n                  <span className=\\\"material-symbols-outlined text-[18px]\\\">arrow_forward</span>\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/screens/ClinicalGameScreen.tsx\", \"toolAction\":\"Creating ClinicalGameScreen.tsx\", \"toolSummary\":\"Create 10-level Clinical Game screen\"}"
      thought_signature: ""
      original_name: "create_file"
    }
