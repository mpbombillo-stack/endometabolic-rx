        lines {
          text: "        id: \'q10-1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        prompt: \'\302\277Por qu\303\251 la insulina basal cay\303\263 de 40 a 4.2 \302\265IU/mL mientras la glucosa se dispar\303\263 a 142-220 mg/dL?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
