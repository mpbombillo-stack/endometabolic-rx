ntigravity\\n\\nYou are the primary software engineer and clinical informatics specialist running inside the Google Antigravity Linux sandbox container.\\n\\n### Project Architecture\\n- Framework: React 19 + TypeScript + Vite 8\\n- Styling: Tailwind CSS v4 (@import \\\"tailwindcss\\\";) + Material Symbols Outlined + Inter / JetBrains Mono\\n- Domain: Functional Medicine Decision Support System (CDSS), ATM Pathophysiology Matrix, Kraft OGTT Curves, Surrogate Biomarker Calculators (HOMA-IR, QUICKI, TyG, TyG-BMI, METS-IR, LAP, VAI, FLI), and FHIR R4 interoperability.\\n- Branding: Functional Care (Medicina Funcional y Regenerativa) & EndoMetabolic Rx.\\n\\n### Build & Execution Commands\\n\\\\`\\\\`\\\\`bash\\n# Install dependencies\\nnpm install\\n\\n# Type-check & lint codebase\\nnpm run lint\\n\\n# Compile production bundle\\nnpm run build\\n\\n# Start development server on port 3000\\nnpm run dev\\n\\\\`\\\\`\\\\`\\n`;\\n\\n  const runnerCode = `import { GoogleGenAI } from \'@google/genai\';\\n\\nconst ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\\n\\nconst interaction = await ai.interactions.create({\\n  agent: \'antigravity-preview-09-2026\',\\n  input: \'Ejecuta y audita la plataforma EndoMetabolic Rx - Functional Care en /workspace\',\\n  environment: \'remote\',\\n  tools: [\\n    { type: \'code_execution\' },\\n    { type: \'google_search\' },\\n    { type: \'url_context\' },\\n  ],\\n}, { timeout: 300000 });\\n\\nconsole.log(interaction.output_text);`;\\n\\n  const quickInstallGuide = `# 1. Clonar o descargar el repositorio\\ngit clone <tu-repositorio>\\ncd applet\\n\\n# 2. Instalar dependencias\\nnpm install\\n\\n# 3. Validar tipado y compilaci\303\263n\\nnpm run lint\\nnpm run build\\n\\n# 4. Iniciar servidor de desarrollo en puerto 3000\\nnpm run dev\\n\\n# 5. Invocar mediante Antigravity Agent (Google GenAI SDK >= 2.4.0)\\nnpx tsx scripts/antigravity-runner.ts`;\\n\\n  const getContentToCopy = () => {\\n    switch (activeTab) {\\n      case \'config\':\\n        return antigravityConfigContent;\\n      case \'agents_md\':\\n        return agentsMdContent;\\n      case \'runner\':\\n        return runnerCode;\\n      case \'install\':\\n        return quickInstallGuide;\\n    }\\n  };\\n\\n  const handleCopy = () => {\\n    navigator.clipboard.writeText(getContentToCopy());\\n    setCopied(true);\\n    onShowToast(\'\302\241C\303\263digo copiado al portapapeles!\');\\n    setTimeout(() => setCopied(false), 2000);\\n  };\\n\\n  const handleDownloadZip = () => {\\n    const bundleData = {\\n      manifest: \'EndoMetabolic Rx - Functional Care Antigravity Export\',\\n      exportedAt: new Date().toISOString(),\\n      agent: \'antigravity-preview-09-2026\',\\n      files: {\\n        \'antigravity.config.json\': antigravityConfigContent,\\n        \'.agents/AGENTS.md\': agentsMdContent,\\n        \'scripts/antigravity-runner.ts\': runnerCode,\\n        \'README.md\': quickInstallGuide,\\n      },\\n    };\\n\\n    const blob = new Blob([JSON.stringify(bundleData, null, 2)], {\\n      type: \'application/json\',\\n    });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `antigravity-export-${Date.now()}.json`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n    onShowToast(\'\302\241Paquete de exportaci\303\263n para Antigravity descargado!\');\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 bg-[#33302d]/40 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-200\\\">\\n      <div className=\\\"bg-[#ffffff] rounded-2xl max-w-3xl w-full p-5 md:p-6 shadow-2xl relative max-h-[85vh] flex flex-col border border-[#e9e1dd]\\\">\\n        {/* Modal Header */}\\n        <div className=\\\"flex items-center justify-between pb-3 border-b border-[#eee7e3]\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <FunctionalCareLogo variant=\\\"emblem\\\" height={34} />\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"text-[16px] font-bold text-[#1e1b19] block\\\">\\n                  Exportaci\303\263n de C\303\263digo para Antigravity\\n                </span>\\n                <span className=\\\"px-2 py-0.5 rounded-full bg-[#005c55]/10 text-[#005c55] text-[10px] font-bold\\\">\\n                  antigravity-preview-09-2026\\n                </span>\\n              </div>\\n              <span className=\\\"text-[11px] text-[#6e7977]\\\">\\n                Configuraci\303\263n completa y scripts de ejecuci\303\263n para el sandbox Linux de Google Antigravity\\n              </span>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"text-[#6e7977] hover:text-[#1e1b19] p-1 rounded-md hover:bg-[#faf2ee] transition-colors\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[22px]\\\">close</span>\\n          </button>\\n        </div>\\n\\n        {/* Tab Switcher */}\\n        <div className=\\\"flex items-center gap-2 mt-3 border-b border-[#eee7e3] pb-2 text-[12px]\\\">\\n          <button\\n            onClick={() => setActiveTab(\'config\')}\\n            className={`px-3 py-1.5 rounded-lg font-bold transition-colors cursor-pointer ${\\n              activeTab === \'config\'\\n                ? \'bg-[#005c55] text-white shadow-sm\'\\n                : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n            }`}\\n          >\\n            antigravity.config.json\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'agents_md\')}\\n            className={`px-3 py-1.5 rounded-lg font-bold transition-colors cursor-pointer ${\\n              activeTab === \'agents_md\'\\n                ? \'bg-[#005c55] text-white shadow-sm\'\\n                : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n            }`}\\n          >\\n            .agents/AGENTS.md\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'runner\')}\\n            className={`px-3 py-1.5 rounded-lg font-bold transition-colors cursor-pointer ${\\n              activeTab === \'runner\'\\n                ? \'bg-[#005c55] text-white shadow-sm\'\\n                : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n            }`}\\n          >\\n            Runner TS (SDK @google/genai)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'install\')}\\n            className={`px-3 py-1.5 rounded-lg font-bold transition-colors cursor-pointer ${\\n              activeTab === \'install\'\\n                ? \'bg-[#005c55] text-white shadow-sm\'\\n                : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n            }`}\\n          >\\n            Comandos de Inicio\\n          </button>\\n        </div>\\n\\n        {/* Code Content Container */}\\n        <div className=\\\"overflow-y-auto mt-3 p-4 rounded-xl bg-[#1c1917] font-mono text-[12px] text-[#a3faef] leading-relaxed select-all border border-[#292524] max-h-[380px]\\\">\\n          <pre>\\n            <code>{getContentToCopy()}</code>\\n          </pre>\\n        </div>\\n\\n        {/* Modal Actions */}\\n        <div className=\\\"mt-4 pt-3 border-t border-[#eee7e3] flex flex-wrap justify-between items-center gap-2\\\">\\n          <span className=\\\"text-[11px] text-[#6e7977]\\\">\\n            Compatible con Google GenAI SDK &gt;= 2.4.0 e Interactions API\\n          </span>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={handleCopy}\\n              className=\\\"px-3.5 py-1.5 rounded-lg bg-[#faf2ee] hover:bg-[#f4ece8] text-[#1e1b19] text-[12px] font-bold flex items-center gap-1.5 transition-colors border border-[#e9e1dd] cursor-pointer\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[16px]\\\">\\n                {copied ? \'check\' : \'content_copy\'}\\n              </span>\\n              <span>{copied ? \'Copiado\' : \'Copiar al Portapapeles\'}</span>\\n            </button>\\n            <button\\n              onClick={handleDownloadZip}\\n              className=\\\"px-4 py-1.5 rounded-lg bg-[#005c55] hover:bg-[#0f766e] text-white text-[12px] font-bold flex items-center gap-1.5 transition-colors shadow-sm cursor-pointer\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[16px]\\\">download</span>\\n              <span>Descargar Bundle JSON</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AntigravityExportModal.tsx\", \"toolAction\":\"Creating AntigravityExportModal.tsx\", \"toolSummary\":\"Create Antigravity export modal\"}"
