    instruction: "Add FunctionalCareLogo to ClinicalGameScreen header"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { GAME_LEVELS } from \'../data/gameLevelsData\';\nimport { KRAFT_PATTERNS_MAP } from \'../utils/metabolicCalculators\';\nimport { GameLevel } from \'../types\';\n\ninterface ClinicalGameScreenProps {\n  onShowToast: (msg: string) => void;\n  gameScore: number;\n  onUpdateScore: (newScore: number) => void;\n  currentLevelNumber: number;\n  onUpdateLevel: (level: number) => void;\n}\n\nexport const ClinicalGameScreen: React.FC<ClinicalGameScreenProps> = ({\n  onShowToast,\n  gameScore,\n  onUpdateScore,\n  currentLevelNumber,\n  onUpdateLevel,\n}) => {\n  const [selectedLevelId, setSelectedLevelId] = useState<number>(currentLevelNumber || 1);\n  const [currentQuestionIndex, setCurrentQuestionIndex] = useState<number>(0);\n  const [selectedOptionIndex, setSelectedOptionIndex] = useState<number | null>(null);\n  const [showExplanation, setShowExplanation] = useState<boolean>(false);\n  const [levelStars, setLevelStars] = useState<Record<number, number>>({ 1: 3 });\n  const [comboStreak, setComboStreak] = useState<number>(0);\n\n  const level: GameLevel = GAME_LEVELS.find((l) => l.id === selectedLevelId) || GAME_LEVELS[0];\n  const question = level.questions[currentQuestionIndex] || level.questions[0];\n  const patternInfo = KRAFT_PATTERNS_MAP[level.kraftPattern] || KRAFT_PATTERNS_MAP[\'pattern-2\'];\n\n  const handleSelectOption = (index: number) => {\n    if (showExplanation) return;\n    setSelectedOptionIndex(index);\n    setShowExplanation(true);\n\n    const isCorrect = question.options[index]?.correct;\n    if (isCorrect) {\n      const addedPoints = 100 + comboStreak * 25;\n      const newScore = gameScore + addedPoints;\n      onUpdateScore(newScore);\n      setComboStreak((c) => c + 1);\n      onShowToast(`\302\241Diagn\303\263stico Correcto! +${addedPoints} pts \360\237\216\257`);\n    } else {\n      setComboStreak(0);\n      onShowToast(\'Diagn\303\263stico incorrecto. Revisa el fundamento cl\303\255nico.\');\n    }\n  };\n\n  const handleNextQuestion = () => {\n    if (currentQuestionIndex < level.questions.length - 1) {\n      setCurrentQuestionIndex((prev) => prev + 1);\n      setSelectedOptionIndex(null);\n      setShowExplanation(false);\n    } else {\n      // Level completed!\n      const starsEarned = 3;\n      setLevelStars((prev) => ({\n        ...prev,\n        [level.id]: Math.max(prev[level.id] || 0, starsEarned),\n        // Unlock next level\n        [level.id + 1]: prev[level.id + 1] || 0,\n      }));\n      onShowToast(`\302\241Nivel ${level.levelNumber} Completado con \303\211xito! \360\237\217\206`);\n\n      if (level.levelNumber < 10) {\n        onUpdateLevel(level.levelNumber + 1);\n        setSelectedLevelId(level.levelNumber + 1);\n        setCurrentQuestionIndex(0);\n        setSelectedOptionIndex(null);\n        setShowExplanation(false);\n      }\n    }\n  };\n\n  const selectLevel = (lvlId: number) => {\n    setSelectedLevelId(lvlId);\n    setCurrentQuestionIndex(0);\n    setSelectedOptionIndex(null);\n    setShowExplanation(false);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full gap-6\">\n      {/* Eye-catching Modern Game Header */}\n      <section className=\"w-full bg-gradient-to-r from-[#005c55] via-[#0f766e] to-[#904d00] rounded-2xl p-5 md:p-6 shadow-md text-white flex flex-col lg:flex-row lg:items-center justify-between gap-4 relative overflow-hidden\">\n        <div className=\"absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-white/10 blur-2xl pointer-events-none\" />\n        <div className=\"flex flex-col gap-1 z-10\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2.5 py-0.5 rounded-full bg-white/20 text-[11px] font-bold uppercase tracking-wider backdrop-blur-sm\">\n              SIMULADOR CL\303\215NICO INTERACTIVO\n            </span>\n            <span className=\"text-[12px] text-[#9cf2e8] flex items-center gap-1 font-semibold\">\n              <span className=\"material-symbols-outlined text-[16px] animate-spin\">autorenew</span>\n              10 Niveles de Complejidad Progresiva\n            </span>\n          </div>\n          <h1 className=\"text-[24px] md:text-[26px] font-black tracking-tight mt-0.5\">\n            Desaf\303\255o Cl\303\255nico: Maestro en Fenotipos Metab\303\263licos y Curvas Kraft\n          </h1>\n          <p className=\"text-[13px] text-white/90 max-w-2xl leading-relaxed\">\n            Resuelve casos cl\303\255nicos de pacientes reales. Diagnostica patrones de insulina Kraft, identifica mediadores de la matriz ATM y selecciona la directiva de intervenci\303\263n adecuada para desbloquear el siguiente nivel.\n          </p>\n        </div>"
        replacement_content: "import React, { useState } from \'react\';\nimport { GAME_LEVELS } from \'../data/gameLevelsData\';\nimport { KRAFT_PATTERNS_MAP } from \'../utils/metabolicCalculators\';\nimport { GameLevel } from \'../types\';\nimport { FunctionalCareLogo } from \'../components/FunctionalCareLogo\';\n\ninterface ClinicalGameScreenProps {\n  onShowToast: (msg: string) => void;\n  gameScore: number;\n  onUpdateScore: (newScore: number) => void;\n  currentLevelNumber: number;\n  onUpdateLevel: (level: number) => void;\n}\n\nexport const ClinicalGameScreen: React.FC<ClinicalGameScreenProps> = ({\n  onShowToast,\n  gameScore,\n  onUpdateScore,\n  currentLevelNumber,\n  onUpdateLevel,\n}) => {\n  const [selectedLevelId, setSelectedLevelId] = useState<number>(currentLevelNumber || 1);\n  const [currentQuestionIndex, setCurrentQuestionIndex] = useState<number>(0);\n  const [selectedOptionIndex, setSelectedOptionIndex] = useState<number | null>(null);\n  const [showExplanation, setShowExplanation] = useState<boolean>(false);\n  const [levelStars, setLevelStars] = useState<Record<number, number>>({ 1: 3 });\n  const [comboStreak, setComboStreak] = useState<number>(0);\n\n  const level: GameLevel = GAME_LEVELS.find((l) => l.id === selectedLevelId) || GAME_LEVELS[0];\n  const question = level.questions[currentQuestionIndex] || level.questions[0];\n  const patternInfo = KRAFT_PATTERNS_MAP[level.kraftPattern] || KRAFT_PATTERNS_MAP[\'pattern-2\'];\n\n  const handleSelectOption = (index: number) => {\n    if (showExplanation) return;\n    setSelectedOptionIndex(index);\n    setShowExplanation(true);\n\n    const isCorrect = question.options[index]?.correct;\n    if (isCorrect) {\n      const addedPoints = 100 + comboStreak * 25;\n      const newScore = gameScore + addedPoints;\n      onUpdateScore(newScore);\n      setComboStreak((c) => c + 1);\n      onShowToast(`\302\241Diagn\303\263stico Correcto! +${addedPoints} pts \360\237\216\257`);\n    } else {\n      setComboStreak(0);\n      onShowToast(\'Diagn\303\263stico incorrecto. Revisa el fundamento cl\303\255nico.\');\n    }\n  };\n\n  const handleNextQuestion = () => {\n    if (currentQuestionIndex < level.questions.length - 1) {\n      setCurrentQuestionIndex((prev) => prev + 1);\n      setSelectedOptionIndex(null);\n      setShowExplanation(false);\n    } else {\n      // Level completed!\n      const starsEarned = 3;\n      setLevelStars((prev) => ({\n        ...prev,\n        [level.id]: Math.max(prev[level.id] || 0, starsEarned),\n        // Unlock next level\n        [level.id + 1]: prev[level.id + 1] || 0,\n      }));\n      onShowToast(`\302\241Nivel ${level.levelNumber} Completado con \303\211xito! \360\237\217\206`);\n\n      if (level.levelNumber < 10) {\n        onUpdateLevel(level.levelNumber + 1);\n        setSelectedLevelId(level.levelNumber + 1);\n        setCurrentQuestionIndex(0);\n        setSelectedOptionIndex(null);\n        setShowExplanation(false);\n      }\n    }\n  };\n\n  const selectLevel = (lvlId: number) => {\n    setSelectedLevelId(lvlId);\n    setCurrentQuestionIndex(0);\n    setSelectedOptionIndex(null);\n    setShowExplanation(false);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full gap-6\">\n      {/* Eye-catching Modern Game Header */}\n      <section className=\"w-full bg-gradient-to-r from-[#005c55] via-[#0f766e] to-[#904d00] rounded-2xl p-5 md:p-6 shadow-md text-white flex flex-col lg:flex-row lg:items-center justify-between gap-4 relative overflow-hidden\">\n        <div className=\"absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-white/10 blur-2xl pointer-events-none\" />\n        <div className=\"flex flex-col gap-1 z-10\">\n          <div className=\"flex items-center gap-3\">\n            <FunctionalCareLogo variant=\"emblem\" height={36} />\n            <div className=\"flex items-center gap-2\">\n              <span className=\"px-2.5 py-0.5 rounded-full bg-white/20 text-[11px] font-bold uppercase tracking-wider backdrop-blur-sm\">\n                SIMULADOR CL\303\215NICO INTERACTIVO\n              </span>\n              <span className=\"text-[12px] text-[#9cf2e8] flex items-center gap-1 font-semibold\">\n                <span className=\"material-symbols-outlined text-[16px] animate-spin\">autorenew</span>\n                10 Niveles de Complejidad Progresiva\n              </span>\n            </div>\n          </div>\n          <h1 className=\"text-[24px] md:text-[26px] font-black tracking-tight mt-1\">\n            Desaf\303\255o Cl\303\255nico: Maestro en Fenotipos Metab\303\263licos y Curvas Kraft\n          </h1>\n          <p className=\"text-[13px] text-white/90 max-w-2xl leading-relaxed\">\n            Resuelve casos cl\303\255nicos de pacientes reales. Diagnostica patrones de insulina Kraft, identifica mediadores de la matriz ATM y selecciona la directiva de intervenci\303\263n adecuada para desbloquear el siguiente nivel.\n          </p>\n        </div>"
      }
      num_matches: 1
    }
  }
}
