  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 59
    content: "import React from \'react\';\nimport { ScreenTab } from \'../types\';\nimport { FunctionalCareLogo } from \'./FunctionalCareLogo\';\n\ninterface HeaderProps {\n  currentTab: ScreenTab;\n  onTabChange: (tab: ScreenTab) => void;\n  clinicalMode: boolean;\n  onToggleClinicalMode: () => void;\n  currentPatientName?: string;\n  gameLevel?: number;\n  gameScore?: number;\n  onOpenAntigravityExport?: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onTabChange,\n  clinicalMode,\n  onToggleClinicalMode,\n  currentPatientName = \'Eleanor Vance, 44a F\',\n  gameLevel = 1,\n  gameScore = 0,\n  onOpenAntigravityExport,\n}) => {\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 bg-[#ffffff]/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-[#e7e5e4]\">\n      {/* Upper Brand & Telemetry Bar */}\n      <div className=\"h-28 w-full px-4 md:px-6 flex flex-col justify-between py-2\">\n        <div className=\"flex items-center justify-between\">\n          {/* Functional Care Logo & Clinical System Title */}\n          <div className=\"flex items-center gap-3 md:gap-4\">\n            <FunctionalCareLogo variant=\"full\" height={44} />\n\n            <div className=\"hidden sm:flex items-center pl-3 border-l border-[#e9e1dd]\">\n              <span className=\"px-2 py-0.5 rounded bg-[#005c55]/10 text-[#005c55] text-[10.5px] font-bold tracking-tight\">\n                EndoMetabolic Rx \342\200\242 CDSS\n              </span>\n            </div>\n          </div>\n\n          {/* Right Header Status Controls */}\n          <div className=\"flex items-center gap-2 md:gap-3\">\n            {/* Antigravity Export Button */}\n            <button\n              onClick={onOpenAntigravityExport}\n              className=\"flex items-center gap-1.5 px-3 py-1 bg-[#005c55] hover:bg-[#0f766e] text-white rounded-lg text-xs font-bold transition-all shadow-sm cursor-pointer\"\n              title=\"Exportar c\303\263digo y configuraci\303\263n para Google Antigravity Agent\"\n            >\n              <span className=\"material-symbols-outlined text-[16px] text-[#9cf2e8]\">\n                cloud_upload\n              </span>\n              <span>Exportar para Antigravity</span>\n            </button>\n\n            {/* Quick Game Score Pill if in game tab */}\n            {currentTab === \'clinical-game\' && (\n              <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-[#fe932c]/15 text-[#904d00] rounded-lg text-xs font-semibold\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#fe932c]\">sports_esports</span>\n                <span>Nivel {gameLevel}/10</span>"
    raw_content: "import React from \'react\';\nimport { ScreenTab } from \'../types\';\nimport { FunctionalCareLogo } from \'./FunctionalCareLogo\';\n\ninterface HeaderProps {\n  currentTab: ScreenTab;\n  onTabChange: (tab: ScreenTab) => void;\n  clinicalMode: boolean;\n  onToggleClinicalMode: () => void;\n  currentPatientName?: string;\n  gameLevel?: number;\n  gameScore?: number;\n  onOpenAntigravityExport?: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onTabChange,\n  clinicalMode,\n  onToggleClinicalMode,\n  currentPatientName = \'Eleanor Vance, 44a F\',\n  gameLevel = 1,\n  gameScore = 0,\n  onOpenAntigravityExport,\n}) => {\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 bg-[#ffffff]/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-[#e7e5e4]\">\n      {/* Upper Brand & Telemetry Bar */}\n      <div className=\"h-28 w-full px-4 md:px-6 flex flex-col justify-between py-2\">\n        <div className=\"flex items-center justify-between\">\n          {/* Functional Care Logo & Clinical System Title */}\n          <div className=\"flex items-center gap-3 md:gap-4\">\n            <FunctionalCareLogo variant=\"full\" height={44} />\n\n            <div className=\"hidden sm:flex items-center pl-3 border-l border-[#e9e1dd]\">\n              <span className=\"px-2 py-0.5 rounded bg-[#005c55]/10 text-[#005c55] text-[10.5px] font-bold tracking-tight\">\n                EndoMetabolic Rx \342\200\242 CDSS\n              </span>\n            </div>\n          </div>\n\n          {/* Right Header Status Controls */}\n          <div className=\"flex items-center gap-2 md:gap-3\">\n            {/* Antigravity Export Button */}\n            <button\n              onClick={onOpenAntigravityExport}\n              className=\"flex items-center gap-1.5 px-3 py-1 bg-[#005c55] hover:bg-[#0f766e] text-white rounded-lg text-xs font-bold transition-all shadow-sm cursor-pointer\"\n              title=\"Exportar c\303\263digo y configuraci\303\263n para Google Antigravity Agent\"\n            >\n              <span className=\"material-symbols-outlined text-[16px] text-[#9cf2e8]\">\n                cloud_upload\n              </span>\n              <span>Exportar para Antigravity</span>\n            </button>\n\n            {/* Quick Game Score Pill if in game tab */}\n            {currentTab === \'clinical-game\' && (\n              <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-[#fe932c]/15 text-[#904d00] rounded-lg text-xs font-semibold\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#fe932c]\">sports_esports</span>\n                <span>Nivel {gameLevel}/10</span>\n                <span className=\"text-[#bdc9c6]\">|</span>\n                <span className=\"tabular-nums\">{gameScore} pts</span>\n              </div>\n            )}\n\n            {/* Clinical Mode Functional vs Conventional Toggle */}\n            <button\n              onClick={onToggleClinicalMode}\n              className=\"hidden lg:flex items-center gap-1.5 px-3 py-1 bg-[#faf2ee] hover:bg-[#f4ece8] rounded-lg text-[#005c55] border border-[#e9e1dd] transition-colors cursor-pointer text-left\"\n              title=\"Alternar vista de umbrales funcionales \303\263ptimos vs criterios poblacionales convencionales\"\n            >\n              <span\n                className={`w-2 h-2 rounded-full ${\n                  clinicalMode ? \'bg-[#005c55] animate-pulse\' : \'bg-[#6e7977]\'\n                }`}\n              />\n              <span className=\"text-[11px] font-semibold\">\n                {clinicalMode\n                  ? \'Modo Cl\303\255nico: Funcional vs. Convencional Habilitado\'\n                  : \'Modo Cl\303\255nico: Convencional\'}\n              </span>\n            </button>\n\n            {/* Profile Avatar / Settings */}\n            <div\n              className=\"w-8 h-8 rounded-full bg-[#005c55] text-white flex items-center justify-center shadow-sm cursor-pointer hover:bg-[#0f766e] transition-colors\"\n              title=\"Dr. M. Thorne, IFMCP\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">person</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Patient Sub-Ribbon */}\n        <div className=\"flex items-center justify-between gap-2 px-3 py-1 bg-[#faf2ee] rounded border border-[#f4ece8] text-[12px] text-[#3e4947] overflow-x-auto no-scrollbar\">\n          <div className=\"flex items-center flex-wrap gap-x-3 gap-y-0.5 whitespace-nowrap\">\n            <span className=\"font-semibold text-[#1e1b19]\">\n              Paciente: {currentPatientName}\n            </span>\n            <span className=\"text-[#bdc9c6]\">|</span>\n            <span>\n              N\302\272 Historia / MRN: <strong className=\"text-[#1e1b19] font-medium\">#FM-88219</strong>\n            </span>\n            <span className=\"text-[#bdc9c6]\">|</span>\n            <span>\n              Ayuno: <strong className=\"text-[#1e1b19] font-medium\">12.4h</strong>\n            </span>\n            <span className=\"text-[#bdc9c6]\">|</span>\n            <span>\n              Protocolo:{\' \'}\n              <strong className=\"text-[#1e1b19] font-medium\">\n                Reseteo Metab\303\263lico Dirigido v3.2\n              </strong>\n            </span>\n            <span className=\"text-[#bdc9c6]\">|</span>\n            <span>\n              M\303\251dico Tratante:{\' \'}\n              <strong className=\"text-[#1e1b19] font-medium\">Dr. M. Thorne, IFMCP</strong>\n            </span>\n          </div>\n          <div className=\"hidden md:flex items-center gap-1 text-[11px] text-[#005c55] font-semibold whitespace-nowrap shrink-0\">\n            <span className=\"material-symbols-outlined text-[15px]\">verified</span>\n            <span>Sincronizaci\303\263n Telemetr\303\255a de Estratos</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Tab Navigation Bar */}\n      <div className=\"px-4 md:px-6 bg-[#ffffff] shadow-[0_1px_0_rgba(0,0,0,0.03)] border-t border-[#f4ece8]\">\n        <nav className=\"flex items-center gap-4 md:gap-6 overflow-x-auto no-scrollbar h-10\">\n          <button\n            onClick={() => onTabChange(\'pathophysiology-atm\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'pathophysiology-atm\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            Fisiopatolog\303\255a y ATM\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'surrogate-indices\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'surrogate-indices\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            Calculadora de \303\215ndices Subrogados\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'kraft-ogtt-curves\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'kraft-ogtt-curves\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            Curvas Kraft OGTT\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'cdss-stratification\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'cdss-stratification\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            CDSS y Estratificaci\303\263n\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'therapeutics-matrix\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'therapeutics-matrix\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            Matriz Terap\303\251utica\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'monitoring-fhir\')}\n            className={`inline-flex items-center h-full text-[13px] font-medium transition-colors whitespace-nowrap px-1 border-b-2 cursor-pointer ${\n              currentTab === \'monitoring-fhir\'\n                ? \'text-[#005c55] border-[#005c55] font-semibold\'\n                : \'text-[#3e4947] border-transparent hover:text-[#1e1b19]\'\n            }`}\n          >\n            Monitoreo y FHIR\n          </button>\n\n          {/* Gamified Clinical Challenge 10 Levels Tab */}\n          <button\n            onClick={() => onTabChange(\'clinical-game\')}\n            className={`inline-flex items-center gap-1.5 h-full text-[13px] font-semibold transition-colors whitespace-nowrap px-2.5 border-b-2 cursor-pointer ${\n              currentTab === \'clinical-game\'\n                ? \'text-[#904d00] border-[#904d00] bg-[#fe932c]/10\'\n                : \'text-[#904d00] border-transparent hover:bg-[#fe932c]/5\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[16px] text-[#fe932c] animate-bounce\">\n              rewarded_ads\n            </span>\n            <span>Desaf\303\255o Cl\303\255nico (10 Niveles)</span>\n            <span className=\"px-1.5 py-0.2 rounded-full text-[10px] bg-[#904d00] text-white\">\n              Juego\n            </span>\n          </button>\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 219
    num_bytes: 9879
  }
}
