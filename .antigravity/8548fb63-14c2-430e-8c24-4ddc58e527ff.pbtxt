    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { ScreenTab } from \'../types\';\n\ninterface HeaderProps {\n  currentTab: ScreenTab;\n  onTabChange: (tab: ScreenTab) => void;\n  clinicalMode: boolean;\n  onToggleClinicalMode: () => void;\n  currentPatientName?: string;\n  gameLevel?: number;\n  gameScore?: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onTabChange,\n  clinicalMode,\n  onToggleClinicalMode,\n  currentPatientName = \'Eleanor Vance, 44a F\',\n  gameLevel = 1,\n  gameScore = 0,\n}) => {\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 bg-[#ffffff]/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-[#e7e5e4]\">\n      {/* Upper Brand & Telemetry Bar */}\n      <div className=\"h-28 w-full px-4 md:px-6 flex flex-col justify-between py-2\">\n        <div className=\"flex items-center justify-between\">\n          {/* Logo & Clinical System Title */}\n          <div className=\"flex items-center gap-3 md:gap-4\">\n            <div className=\"h-9 w-9 rounded-lg bg-[#005c55] flex items-center justify-center text-white shadow-sm overflow-hidden flex-shrink-0\">\n              <img\n                alt=\"EndoMetabolic Functional Medicine Logo\"\n                className=\"h-8 w-auto object-contain\"\n                src=\"https://lh3.googleusercontent.com/aida/AEtjO1Wga62YWzmUSkxCzaBaL_5HgnasHhqSHbY44aq3I9zb4-EOviR5pu0CKTKK-U_7Qqcoepk0NzDO1kkL5hUPE8jQ8cgij4VM4R1aqyq44S7fb3tqq2ug7Ri-8BhpD-LTFO4Id0VHRuhJcKtkotH-iMp3z23gC2I8LHoHC_P_YyvvYJGFEhs1YxVh7DDN3J-bJ6JvZ6tagJ5i5KFDHKwgCwOLMyvw2bCckvtAEmB_3sojf8xu1x7ssTiXA3A\"\n                onError={(e) => {\n                  (e.target as HTMLElement).style.display = \'none\';\n                }}\n              />\n            </div>\n            <div className=\"flex flex-col\">\n              <span className=\"text-[17px] md:text-[19px] font-bold text-[#005c55] leading-tight tracking-tight\">\n                EndoMetabolic Rx\n              </span>\n              <span className=\"text-[10px] md:text-[11px] font-semibold text-[#6e7977] uppercase tracking-wider\">\n                SISTEMA DE SOPORTE PARA DECISIONES CL\303\215NICAS EN MEDICINA FUNCIONAL\n              </span>\n            </div>\n          </div>"
        replacement_content: "import React from \'react\';\nimport { ScreenTab } from \'../types\';\nimport { FunctionalCareLogo } from \'./FunctionalCareLogo\';\n\ninterface HeaderProps {\n  currentTab: ScreenTab;\n  onTabChange: (tab: ScreenTab) => void;\n  clinicalMode: boolean;\n  onToggleClinicalMode: () => void;\n  currentPatientName?: string;\n  gameLevel?: number;\n  gameScore?: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentTab,\n  onTabChange,\n  clinicalMode,\n  onToggleClinicalMode,\n  currentPatientName = \'Eleanor Vance, 44a F\',\n  gameLevel = 1,\n  gameScore = 0,\n}) => {\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 bg-[#ffffff]/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-[#e7e5e4]\">\n      {/* Upper Brand & Telemetry Bar */}\n      <div className=\"h-28 w-full px-4 md:px-6 flex flex-col justify-between py-2\">\n        <div className=\"flex items-center justify-between\">\n          {/* Functional Care Logo & Clinical System Title */}\n          <div className=\"flex items-center gap-3 md:gap-4\">\n            <FunctionalCareLogo variant=\"full\" height={44} />\n\n            <div className=\"hidden sm:flex items-center pl-3 border-l border-[#e9e1dd]\">\n              <span className=\"px-2 py-0.5 rounded bg-[#005c55]/10 text-[#005c55] text-[10.5px] font-bold tracking-tight\">\n                EndoMetabolic Rx \342\200\242 CDSS\n              </span>\n            </div>\n          </div>"
      }
      num_matches: 1
    }
