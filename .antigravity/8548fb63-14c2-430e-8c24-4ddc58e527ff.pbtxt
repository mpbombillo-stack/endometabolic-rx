        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Aproximadamente el 70% al 80% del bolo de glucosa absorbida.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Correcto: El m\303\272sculo es el sumidero metab\303\263lico m\303\241s grande del cuerpo. Cuando se pierde masa muscular (sarcopenia), se reduce dr\303\241sticamente el reservorio para depositar glucosa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Menos del 20%, ya que casi toda la glucosa la utiliza el cerebro.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: El cerebro consume glucosa constante en ayunas, pero el m\303\272sculo absorbe la gran mayor\303\255a de la carga postprandial.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
