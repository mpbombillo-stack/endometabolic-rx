          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        id: \'q10-2\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        prompt: \'\302\277Cu\303\241l es la estrategia inmediata de salvamento metab\303\263lico requerida?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Soporte insul\303\255nico ex\303\263geno temporal para frenar la glucotoxicidad, junto a restauraci\303\263n nutricional estricta, N-Acetil Ciste\303\255na para estr\303\251s oxidativo y protecci\303\263n mitocondrial.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Exacto: Se debe reducir inmediatamente la toxicidad por glucosa para permitir que las c\303\251lulas beta sobrevivientes descansen y potencialmente recuperen funcionalidad.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Prescribir sulfonilureas de alta potencia para forzar a\303\272n m\303\241s al p\303\241ncreas agotado.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: Forzar secretagogos en un p\303\241ncreas exhausto acelera la muerte celular programada.\',"
