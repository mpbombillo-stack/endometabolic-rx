        }
        lines {
          text: "        prompt: \'\302\277Por qu\303\251 los turnos nocturnos cr\303\263nicos provocan hiperglucemia matutina aun sin ingesta previa?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque el cortisol elevado no suprime la enzima PEPCK ni la Glucosa-6-Fosfatasa hep\303\241tica, manteniendo activa la gluconeog\303\251nesis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Exacto: Los glucocorticoides estimulan la s\303\255ntesis hep\303\241tica de glucosa a partir de amino\303\241cidos y glicerol durante toda la madrugada.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
