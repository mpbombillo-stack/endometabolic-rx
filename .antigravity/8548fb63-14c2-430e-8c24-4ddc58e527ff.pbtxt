          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque la melatonina en exceso destruye las c\303\251lulas beta pancre\303\241ticas.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: La alteraci\303\263n circadiana desincroniza receptores perif\303\251ricos, pero no destruye c\303\251lulas beta por toxicidad directa de melatonina.\',"
