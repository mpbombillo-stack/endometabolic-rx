        lines {
          text: "        id: \'q4-2\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        prompt: \'\302\277Por qu\303\251 est\303\241 contraindicado el ayuno prolongado (>18h) en esta paciente seg\303\272n la directiva CDSS?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque su T3 reversa elevada (22 ng/dL) y cortisol aplanado indican riesgo de bloqueo tiroideo y elevaci\303\263n parad\303\263jica de gluconeog\303\251nesis.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Exacto: En pacientes con agotamiento adrenal o resistencia perif\303\251rica a hormona tiroidea, los ayunos excesivos estresan el eje HPA y reducen la tasa metab\303\263lica.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'Porque los ayunos de m\303\241s de 18h est\303\241n prohibidos en todas las personas sin excepci\303\263n.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Incorrecto: El ayuno puede ser terap\303\251utico si los ejes HPA y tiroideo est\303\241n en balance.\',"
