  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    start_line: 61
    end_line: 166
    content: "    <div className=\"min-h-screen bg-[#fff8f5] text-[#1e1b19] font-sans antialiased selection:bg-[#005c55]/20 selection:text-[#005c55]\">\n      {/* Top Header */}\n      <Header\n        currentTab={currentTab}\n        onTabChange={(tab) => setCurrentTab(tab)}\n        clinicalMode={clinicalMode}\n        onToggleClinicalMode={handleToggleClinicalMode}\n        currentPatientName=\"Eleanor Vance, 44a F\"\n        gameLevel={gameLevelNumber}\n        gameScore={gameScore}\n      />\n\n      {/* Persistent Left Clinical Sidebar (Triaje y Cohorte) */}\n      <Sidebar\n        labs={patientLabs}\n        homaIr={surrogates.homaIr}\n        stratumName=\"Estrato 2\"\n        stratumStatus=\"Fricci\303\263n Moderada\"\n        onOpenFhir={() => setIsFhirModalOpen(true)}\n        onOpenGame={() => setCurrentTab(\'clinical-game\')}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"xl:pl-64\">\n        <main className=\"w-full pt-[156px] min-h-screen px-4 md:px-6 py-6 pb-16\">\n          {currentTab === \'pathophysiology-atm\' && (\n            <AtmScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onOpenInspector={(node) => setInspectorNode(node)}\n              onNavigateTab={(tab) => setCurrentTab(tab)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'surrogate-indices\' && (\n            <SurrogateIndicesScreen\n              labs={patientLabs}\n              onUpdateLabs={(newLabs) => setPatientLabs(newLabs)}\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'kraft-ogtt-curves\' && (\n            <KraftOgttScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'cdss-stratification\' && (\n            <CdssScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'therapeutics-matrix\' && (\n            <TherapeuticsScreen\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'monitoring-fhir\' && (\n            <MonitoringFhirScreen\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'clinical-game\' && (\n            <ClinicalGameScreen\n              onShowToast={showToast}\n              gameScore={gameScore}\n              onUpdateScore={(newScore) => setGameScore(newScore)}\n              currentLevelNumber={gameLevelNumber}\n              onUpdateLevel={(lvl) => setGameLevelNumber(lvl)}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* FHIR R4 Modal */}\n      <FhirModal\n        isOpen={isFhirModalOpen}\n        onClose={() => setIsFhirModalOpen(false)}\n        labs={patientLabs}\n        patientName=\"Eleanor Vance\"\n        homaIr={surrogates.homaIr}\n        onShowToast={showToast}\n      />\n\n      {/* Matrix Node Clinical Deep Inspector Modal */}\n      <InspectorModal\n        node={inspectorNode}\n        onClose={() => setInspectorNode(null)}\n        onApplyProtocol={handleApplyProtocol}\n      />\n\n      {/* Floating Feedback Toast */}\n      <Toast message={toastMessage} onClose={() => setToastMessage(null)} />\n    </div>\n  );\n}\n"
    raw_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { ScreenTab, PatientLabs, MatrixNodeDetail } from \'./types\';\nimport { ELEANOR_VANCE_LABS } from \'./data/patientData\';\nimport { calculateSurrogates } from \'./utils/metabolicCalculators\';\nimport { Header } from \'./components/Header\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { FhirModal } from \'./components/FhirModal\';\nimport { InspectorModal } from \'./components/InspectorModal\';\nimport { AntigravityExportModal } from \'./components/AntigravityExportModal\';\nimport { Toast } from \'./components/Toast\';\n\nimport { AtmScreen } from \'./screens/AtmScreen\';\nimport { SurrogateIndicesScreen } from \'./screens/SurrogateIndicesScreen\';\nimport { KraftOgttScreen } from \'./screens/KraftOgttScreen\';\nimport { CdssScreen } from \'./screens/CdssScreen\';\nimport { TherapeuticsScreen } from \'./screens/TherapeuticsScreen\';\nimport { MonitoringFhirScreen } from \'./screens/MonitoringFhirScreen\';\nimport { ClinicalGameScreen } from \'./screens/ClinicalGameScreen\';\n\nexport default function App() {\n  const [currentTab, setCurrentTab] = useState<ScreenTab>(\'pathophysiology-atm\');\n  const [clinicalMode, setClinicalMode] = useState<boolean>(true);\n  const [patientLabs, setPatientLabs] = useState<PatientLabs>(ELEANOR_VANCE_LABS);\n  const [isFhirModalOpen, setIsFhirModalOpen] = useState<boolean>(false);\n  const [inspectorNode, setInspectorNode] = useState<MatrixNodeDetail | null>(null);\n  const [isAntigravityModalOpen, setIsAntigravityModalOpen] = useState<boolean>(false);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Game progression state for the 10-level challenge\n  const [gameLevelNumber, setGameLevelNumber] = useState<number>(1);\n  const [gameScore, setGameScore] = useState<number>(0);\n\n  const surrogates = calculateSurrogates(patientLabs);\n\n  const showToast = (message: string) => {\n    setToastMessage(message);\n    setTimeout(() => {\n      setToastMessage((prev) => (prev === message ? null : prev));\n    }, 3200);\n  };\n\n  const handleToggleClinicalMode = () => {\n    setClinicalMode((prev) => !prev);\n    showToast(\n      !clinicalMode\n        ? \'Modo Cl\303\255nico: Umbrales Funcionales \303\223ptimos Habilitados\'\n        : \'Modo Cl\303\255nico: Valores Convencionales Poblacionales\'\n    );\n  };\n\n  const handleApplyProtocol = (nodeName: string) => {\n    setInspectorNode(null);\n    showToast(`\302\241Protocolo de ${nodeName} a\303\261adido al expediente de Eleanor Vance!`);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#fff8f5] text-[#1e1b19] font-sans antialiased selection:bg-[#005c55]/20 selection:text-[#005c55]\">\n      {/* Top Header */}\n      <Header\n        currentTab={currentTab}\n        onTabChange={(tab) => setCurrentTab(tab)}\n        clinicalMode={clinicalMode}\n        onToggleClinicalMode={handleToggleClinicalMode}\n        currentPatientName=\"Eleanor Vance, 44a F\"\n        gameLevel={gameLevelNumber}\n        gameScore={gameScore}\n      />\n\n      {/* Persistent Left Clinical Sidebar (Triaje y Cohorte) */}\n      <Sidebar\n        labs={patientLabs}\n        homaIr={surrogates.homaIr}\n        stratumName=\"Estrato 2\"\n        stratumStatus=\"Fricci\303\263n Moderada\"\n        onOpenFhir={() => setIsFhirModalOpen(true)}\n        onOpenGame={() => setCurrentTab(\'clinical-game\')}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"xl:pl-64\">\n        <main className=\"w-full pt-[156px] min-h-screen px-4 md:px-6 py-6 pb-16\">\n          {currentTab === \'pathophysiology-atm\' && (\n            <AtmScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onOpenInspector={(node) => setInspectorNode(node)}\n              onNavigateTab={(tab) => setCurrentTab(tab)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'surrogate-indices\' && (\n            <SurrogateIndicesScreen\n              labs={patientLabs}\n              onUpdateLabs={(newLabs) => setPatientLabs(newLabs)}\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'kraft-ogtt-curves\' && (\n            <KraftOgttScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'cdss-stratification\' && (\n            <CdssScreen\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n              onShowToast={showToast}\n            />\n          )}\n\n          {currentTab === \'therapeutics-matrix\' && (\n            <TherapeuticsScreen\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'monitoring-fhir\' && (\n            <MonitoringFhirScreen\n              onShowToast={showToast}\n              onOpenFhir={() => setIsFhirModalOpen(true)}\n            />\n          )}\n\n          {currentTab === \'clinical-game\' && (\n            <ClinicalGameScreen\n              onShowToast={showToast}\n              gameScore={gameScore}\n              onUpdateScore={(newScore) => setGameScore(newScore)}\n              currentLevelNumber={gameLevelNumber}\n              onUpdateLevel={(lvl) => setGameLevelNumber(lvl)}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* FHIR R4 Modal */}\n      <FhirModal\n        isOpen={isFhirModalOpen}\n        onClose={() => setIsFhirModalOpen(false)}\n        labs={patientLabs}\n        patientName=\"Eleanor Vance\"\n        homaIr={surrogates.homaIr}\n        onShowToast={showToast}\n      />\n\n      {/* Matrix Node Clinical Deep Inspector Modal */}\n      <InspectorModal\n        node={inspectorNode}\n        onClose={() => setInspectorNode(null)}\n        onApplyProtocol={handleApplyProtocol}\n      />\n\n      {/* Floating Feedback Toast */}\n      <Toast message={toastMessage} onClose={() => setToastMessage(null)} />\n    </div>\n  );\n}\n"
    num_lines: 167
    num_bytes: 5943
  }
}
