      name: "create_file"
      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { FunctionalCareLogo } from \'./FunctionalCareLogo\';\\n\\ninterface AntigravityExportModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  onShowToast: (msg: string) => void;\\n}\\n\\nexport const AntigravityExportModal: React.FC<AntigravityExportModalProps> = ({\\n  isOpen,\\n  onClose,\\n  onShowToast,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'all-in-one-js\' | \'all-in-one-json\' | \'config\' | \'runner\' | \'cli\'>(\'all-in-one-js\');\\n  const [copied, setCopied] = useState(false);\\n\\n  if (!isOpen) return null;\\n\\n  const allInOneJsSnippet = `#!/usr/bin/env node\\n/**\\n * ============================================================================\\n * ENDOMETABOLIC RX - FUNCTIONAL CARE\\n * ARCHIVO \303\232NICO AUT\303\223NOMO (ALL-IN-ONE) PARA GOOGLE ANTIGRAVITY\\n * Agente Base: antigravity-preview-09-2026\\n * ============================================================================\\n * \\n * Contiene el proyecto completo (32 archivos de c\303\263digo TypeScript/React/CSS/FHIR)\\n * y la l\303\263gica para conectarse a Google Antigravity o extraer el c\303\263digo localmente.\\n *\\n * COMANDOS DE USO:\\n *   1. Desplegar en Antigravity:\\n *      export GEMINI_API_KEY=\\\"tu_api_key\\\"\\n *      node antigravity-all-in-one.js\\n *\\n *   2. Registrar Custom Agent permanente en Google GenAI:\\n *      node antigravity-all-in-one.js --register\\n *\\n *   3. Desempaquetar todo el c\303\263digo en una carpeta local:\\n *      node antigravity-all-in-one.js --unpack ./mi-proyecto\\n * ============================================================================\\n */\\n\\nimport * as fs from \'node:fs\';\\nimport * as path from \'node:path\';\\n\\n// MANIFIESTO Y C\303\223DIGO FUENTE COMPLETO DEL PROYECTO\\nexport const ANTIGRAVITY_CONFIG = {\\n  \\\"$schema\\\": \\\"https://developer.google.com/genai/schemas/antigravity-agent.json\\\",\\n  \\\"id\\\": \\\"endometabolic-rx-functional-care\\\",\\n  \\\"name\\\": \\\"EndoMetabolic Rx - Functional Care CDSS\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"base_agent\\\": \\\"antigravity-preview-09-2026\\\",\\n  \\\"metadata\\\": {\\n    \\\"file_count\\\": 32,\\n    \\\"platform\\\": \\\"Google GenAI Antigravity Managed Agent\\\",\\n    \\\"export_type\\\": \\\"Single-File Standalone Bundle\\\"\\n  },\\n  \\\"system_instruction\\\": \\\"Eres el agente cl\303\255nico e ingeniero de software responsable de EndoMetabolic Rx - Functional Care. Sandbox Linux con Node 22, React 19, Vite y Tailwind CSS v4...\\\",\\n  \\\"base_environment\\\": {\\n    \\\"type\\\": \\\"remote\\\",\\n    \\\"runtime\\\": \\\"node22\\\",\\n    \\\"workdir\\\": \\\"/workspace\\\",\\n    \\\"ports\\\": [3000],\\n    \\\"entrypoint\\\": \\\"npm run dev\\\",\\n    \\\"sources\\\": [\\n      /* 32 archivos de c\303\263digo fuente empaquetados inline */\\n    ]\\n  },\\n  \\\"tools\\\": [{ \\\"type\\\": \\\"code_execution\\\" }, { \\\"type\\\": \\\"google_search\\\" }, { \\\"type\\\": \\\"url_context\\\" }]\\n};\\n\\nexport function unpackProject(destDir = \'./endometabolic-rx\') { /* extrae archivos */ }\\nexport async function runInAntigravity(registerPermanent = false) { /* ejecuta en Antigravity */ }\\n`;\\n\\n  const allInOneJsonSnippet = `{\\n  \\\"$schema\\\": \\\"https://developer.google.com/genai/schemas/antigravity-agent.json\\\",\\n  \\\"id\\\": \\\"endometabolic-rx-functional-care\\\",\\n  \\\"name\\\": \\\"EndoMetabolic Rx - Functional Care CDSS\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"base_agent\\\": \\\"antigravity-preview-09-2026\\\",\\n  \\\"metadata\\\": {\\n    \\\"file_count\\\": 32,\\n    \\\"platform\\\": \\\"Google GenAI Antigravity Managed Agent\\\",\\n    \\\"export_type\\\": \\\"Single-File Standalone Bundle\\\"\\n  },\\n  \\\"system_instruction\\\": \\\"Eres el agente cl\303\255nico e ingeniero de software responsable de EndoMetabolic Rx - Functional Care. Sandbox Linux con Node 22, React 19, Vite y Tailwind CSS v4...\\\",\\n  \\\"base_environment\\\": {\\n    \\\"type\\\": \\\"remote\\\",\\n    \\\"runtime\\\": \\\"node22\\\",\\n    \\\"workdir\\\": \\\"/workspace\\\",\\n    \\\"ports\\\": [3000],\\n    \\\"entrypoint\\\": \\\"npm run dev\\\",\\n    \\\"sources\\\": [\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/.agents/AGENTS.md\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/package.json\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/src/App.tsx\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/src/screens/AtmScreen.tsx\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/src/screens/ClinicalGameScreen.tsx\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/src/components/FunctionalCareLogo.tsx\\\", \\\"content\\\": \\\"...\\\" },\\n      { \\\"type\\\": \\\"inline\\\", \\\"target\\\": \\\"/src/utils/metabolicCalculators.ts\\\", \\\"content\\\": \\\"...\\\" }\\n      /* ... 32 archivos empaquetados en un solo archivo */\\n    ]\\n  },\\n  \\\"tools\\\": [\\n    { \\\"type\\\": \\\"code_execution\\\" },\\n    { \\\"type\\\": \\\"google_search\\\" },\\n    { \\\"type\\\": \\\"url_context\\\" }\\n  ]\\n}`;\\n\\n  const configJson = `{\\n  \\\"$schema\\\": \\\"https://developer.google.com/genai/schemas/antigravity-agent.json\\\",\\n  \\\"name\\\": \\\"EndoMetabolic Rx - Functional Care\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"base_agent\\\": \\\"antigravity-preview-09-2026\\\",\\n  \\\"environment\\\": {\\n    \\\"type\\\": \\\"remote\\\",\\n    \\\"runtime\\\": \\\"node22\\\",\\n    \\\"ports\\\": [3000],\\n    \\\"workdir\\\": \\\"/workspace\\\",\\n    \\\"entrypoint\\\": \\\"npm run dev\\\",\\n    \\\"sources\\\": [\\n      {\\n        \\\"type\\\": \\\"inline\\\",\\n        \\\"target\\\": \\\".agents/AGENTS.md\\\"\\n      }\\n    ]\\n  },\\n  \\\"tools\\\": [\\n    { \\\"type\\\": \\\"code_execution\\\" },\\n    { \\\"type\\\": \\\"google_search\\\" },\\n    { \\\"type\\\": \\\"url_context\\\" }\\n  ],\\n  \\\"system_instruction\\\": \\\"You are the clinical engineer executing the EndoMetabolic Rx Functional Medicine platform. Follow the instructions in .agents/AGENTS.md, maintain TypeScript safety without any mock regressions, ensure FHIR R4 standard compliance, and serve the application on port 3000.\\\"\\n}`;\\n\\n  const runnerCode = `/**\\n * Antigravity Agent Invocation Script\\n * Utiliza @google/genai Interactions API con antigravity-preview-09-2026\\n */\\nimport { GoogleGenAI } from \'@google/genai\';\\n\\nasync function runAntigravity() {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\'GEMINI_API_KEY no encontrada en las variables de entorno.\');\\n  }\\n\\n  const ai = new GoogleGenAI({ apiKey });\\n\\n  console.log(\'\360\237\232\200 Inicializando Antigravity Agent (antigravity-preview-09-2026)...\');\\n\\n  const interaction = await ai.interactions.create(\\n    {\\n      agent: \'antigravity-preview-09-2026\',\\n      input: \\n        \'Despliega y verifica EndoMetabolic Rx - Functional Care en el sandbox Linux. \' +\\n        \'Ejecuta \\\"npm run build\\\" y \\\"npm run lint\\\", y valida las 7 pantallas cl\303\255nicas y el desaf\303\255o de 10 niveles.\',\\n      environment: \'remote\',\\n      tools: [\\n        { type: \'code_execution\' },\\n        { type: \'google_search\' },\\n        { type: \'url_context\' }\\n      ]\\n    },\\n    { timeout: 300000 }\\n  );\\n\\n  console.log(\\\\`\360\237\223\246 Sandbox Environment ID: \\\\${interaction.environment_id}\\\\`);\\n  console.log(\\\\`\360\237\223\212 Estado de ejecuci\303\263n: \\\\${interaction.status}\\\\`);\\n\\n  // Extraer respuesta multi-step de Antigravity\\n  let fullOutput = \'\';\\n  for (const step of interaction.steps || []) {\\n    if (step.type === \'model_output\') {\\n      const textPart = step.content?.find((c: any) => c.type === \'text\');\\n      if (textPart?.text) fullOutput += textPart.text;\\n    }\\n  }\\n\\n  console.log(\'--- Salida del Agente Antigravity ---\');\\n  console.log(fullOutput || interaction.output_text);\\n}\\n\\nrunAntigravity().catch(console.error);`;\\n\\n  const handleCopy = (text: string, label: string) => {\\n    navigator.clipboard.writeText(text);\\n    setCopied(true);\\n    onShowToast(`Copiado: ${label}`);\\n    setTimeout(() => setCopied(false), 2000);\\n  };\\n\\n  const handleDownload = (filename: string, content: string) => {\\n    const isJson = filename.endsWith(\'.json\');\\n    const blob = new Blob([content], { type: isJson ? \'application/json\' : \'text/javascript\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = filename;\\n    document.body.appendChild(a);\\n    a.click();\\n    document.body.removeChild(a);\\n    URL.revokeObjectURL(url);\\n    onShowToast(`Archivo descargado: ${filename}`);\\n  };\\n\\n  const getCurrentContent = () => {\\n    switch (activeTab) {\\n      case \'all-in-one-js\':\\n        return allInOneJsSnippet;\\n      case \'all-in-one-json\':\\n        return allInOneJsonSnippet;\\n      case \'config\':\\n        return configJson;\\n      case \'runner\':\\n        return runnerCode;\\n      case \'cli\':\\n        return `# =======================================================\\n# COMANDOS CON EL ARCHIVO \303\232NICO (antigravity-all-in-one.js)\\n# =======================================================\\n\\n# 1. Ejecutar y desplegar directamente en Google Antigravity:\\nexport GEMINI_API_KEY=\\\"tu_api_key_de_ai_studio\\\"\\nnode antigravity-all-in-one.js\\n\\n# 2. Registrar el Custom Agent permanente en Google GenAI:\\nnode antigravity-all-in-one.js --register\\n\\n# 3. Desempaquetar todo el proyecto en una carpeta local:\\nnode antigravity-all-in-one.js --unpack ./endometabolic-app\\n\\n# 4. Regenerar el archivo \303\272nico tras hacer cambios:\\nnpm run export:all-in-one`;\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4 animate-in fade-in duration-200\\\">\\n      <div className=\\\"bg-[#0b1716] border border-[#1b3d39] rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden\\\">\\n        {/* Modal Header */}\\n        <div className=\\\"p-5 border-b border-[#1b3d39] bg-[#071110] flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-4\\\">\\n            <FunctionalCareLogo variant=\\\"emblem\\\" height={38} theme=\\\"colored\\\" />\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <h3 className=\\\"text-lg font-bold text-[#e1e3e2] tracking-wide\\\">\\n                  Exportaci\303\263n en Archivo \303\232nico \342\200\242 Google Antigravity\\n                </h3>\\n                <span className=\\\"bg-[#183431] text-[#71d9cc] border border-[#2b5953] px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-semibold\\\">\\n                  All-in-One Standalone\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-[#859491] mt-0.5\\\">\\n                Todo el c\303\263digo, m\303\263dulos cl\303\255nicos, dise\303\261o y configuraci\303\263n consolidados en un solo archivo\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"text-[#859491] hover:text-white p-2 rounded-lg hover:bg-[#152a28] transition-colors cursor-pointer\\\"\\n            title=\\\"Cerrar modal\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-xl\\\">close</span>\\n          </button>\\n        </div>\\n\\n        {/* Navigation Tabs */}\\n        <div className=\\\"flex border-b border-[#1b3d39] bg-[#0c1d1b] px-5 gap-2 pt-2 overflow-x-auto no-scrollbar\\\">\\n          <button\\n            onClick={() => setActiveTab(\'all-in-one-js\')}\\n            className={`px-3 py-2 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${\\n              activeTab === \'all-in-one-js\'\\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-sm text-[#fe932c]\\\">star</span>\\n            Archivo \303\232nico JS (antigravity-all-in-one.js)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'all-in-one-json\')}\\n            className={`px-3 py-2 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${\\n              activeTab === \'all-in-one-json\'\\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-sm\\\">inventory_2</span>\\n            Archivo \303\232nico JSON (antigravity-all-in-one.json)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'config\')}\\n            className={`px-3 py-2 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${\\n              activeTab === \'config\'\\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-sm\\\">settings_suggest</span>\\n            Config (antigravity.config.json)\\n          </button>\\n          <button\\n            onClick={() => setActiveTab(\'cli\')}\\n            className={`px-3 py-2 text-xs font-semibold rounded-t-lg transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${\\n              activeTab === \'cli\'\\n                ? \'bg-[#152a28] text-[#71d9cc] border-t-2 border-[#005c55] border-x border-[#1b3d39]\'\\n                : \'text-[#859491] hover:text-[#c4d6d3] hover:bg-[#112422]\'\\n            }`}\\n          >\\n            <span className=\\\"material-symbols-outlined text-sm\\\">terminal</span>\\n            Comandos y Uso\\n          </button>\\n        </div>\\n\\n        {/* Content Area */}\\n        <div className=\\\"flex-1 p-5 overflow-y-auto bg-[#081211]\\\">\\n          {/* Metadata Card */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-4 text-xs\\\">\\n            <div className=\\\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\\\">\\n              <span className=\\\"text-[#859491] block text-[10px] uppercase font-mono\\\">Modo de Exportaci\303\263n</span>\\n              <span className=\\\"font-bold text-[#fe932c]\\\">Archivo \303\232nico All-in-One</span>\\n            </div>\\n            <div className=\\\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\\\">\\n              <span className=\\\"text-[#859491] block text-[10px] uppercase font-mono\\\">Archivos Consolidados</span>\\n              <span className=\\\"font-bold text-[#71d9cc]\\\">32 Archivos Fuente</span>\\n            </div>\\n            <div className=\\\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\\\">\\n              <span className=\\\"text-[#859491] block text-[10px] uppercase font-mono\\\">Agente Antigravity</span>\\n              <span className=\\\"font-bold text-[#e1e3e2]\\\">antigravity-preview-09-2026</span>\\n            </div>\\n            <div className=\\\"bg-[#0e211f] border border-[#1b3d39] rounded-lg p-3\\\">\\n              <span className=\\\"text-[#859491] block text-[10px] uppercase font-mono\\\">Funcionalidades</span>\\n              <span className=\\\"font-bold text-[#e1e3e2]\\\">Deploy \342\200\242 Register \342\200\242 Unpack</span>\\n            </div>\\n          </div>\\n\\n          {/* Quick Action Banner */}\\n          <div className=\\\"mb-4 p-3.5 bg-gradient-to-r from-[#005c55]/30 to-[#fe932c]/10 border border-[#005c55]/50 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3 text-xs\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <span className=\\\"material-symbols-outlined text-[#71d9cc] text-xl\\\">folder_zip</span>\\n              <div>\\n                <span className=\\\"font-bold text-white block\\\">\\n                  Descarga directa de archivo \303\272nico para Antigravity\\n                </span>\\n                <span className=\\\"text-[#859491]\\\">\\n                  Guarda <code>antigravity-all-in-one.js</code> o <code>antigravity-all-in-one.json</code> en tu equipo.\\n                </span>\\n              </div>\\n            </div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <button\\n                onClick={() =>\\n                  handleDownload(\\n                    \'antigravity-all-in-one.js\',\\n                    allInOneJsSnippet\\n                  )\\n                }\\n                className=\\\"px-3.5 py-1.5 bg-[#005c55] hover:bg-[#0f766e] text-white font-bold rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer shadow-sm\\\"\\n              >\\n                <span className=\\\"material-symbols-outlined text-sm\\\">download</span>\\n                Descargar JS\\n              </button>\\n              <button\\n                onClick={() =>\\n                  handleDownload(\\n                    \'antigravity-all-in-one.json\',\\n                    allInOneJsonSnippet\\n                  )\\n                }\\n                className=\\\"px-3.5 py-1.5 bg-[#173834] hover:bg-[#204a45] text-[#a3faef] border border-[#2b5953] font-bold rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer\\\"\\n              >\\n                <span className=\\\"material-symbols-outlined text-sm\\\">download</span>\\n                Descargar JSON\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Code Viewer */}\\n          <div className=\\\"relative rounded-xl overflow-hidden border border-[#1b3d39] bg-[#050c0c]\\\">\\n            <div className=\\\"flex items-center justify-between px-4 py-2 bg-[#091514] border-b border-[#1b3d39] text-xs\\\">\\n              <span className=\\\"font-mono text-[#859491]\\\">\\n                {activeTab === \'all-in-one-js\'\\n                  ? \'antigravity-all-in-one.js (Ejecutable Aut\303\263nomo)\'\\n                  : activeTab === \'all-in-one-json\'\\n                  ? \'antigravity-all-in-one.json (Manifiesto de Agente)\'\\n                  : activeTab === \'config\'\\n                  ? \'antigravity.config.json\'\\n                  : \'Instrucciones Terminal\'}\\n              </span>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <button\\n                  onClick={() => handleCopy(getCurrentContent(), activeTab)}\\n                  className=\\\"px-3 py-1 bg-[#142d2a] hover:bg-[#1d433f] text-[#a3faef] border border-[#2b5953] rounded text-xs font-medium flex items-center gap-1.5 transition-colors cursor-pointer\\\"\\n                >\\n                  <span className=\\\"material-symbols-outlined text-sm\\\">\\n                    {copied ? \'check\' : \'content_copy\'}\\n                  </span>\\n                  {copied ? \'Copiado\' : \'Copiar\'}\\n                </button>\\n              </div>\\n            </div>\\n            <pre className=\\\"p-4 text-xs font-mono text-[#c4d6d3] overflow-x-auto max-h-[350px] leading-relaxed selection:bg-[#005c55] selection:text-white\\\">\\n              <code>{getCurrentContent()}</code>\\n            </pre>\\n          </div>\\n        </div>\\n\\n        {/* Modal Footer */}\\n        <div className=\\\"p-4 border-t border-[#1b3d39] bg-[#071110] flex items-center justify-between text-xs\\\">\\n          <div className=\\\"flex items-center gap-2 text-[#859491]\\\">\\n            <span className=\\\"material-symbols-outlined text-base text-[#71d9cc]\\\">verified</span>\\n            <span>\\n              Incluye las 7 pantallas cl\303\255nicas, el simulador de 10 niveles y la suite de c\303\241lculo metab\303\263lico\\n            </span>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"px-5 py-2 bg-[#1b3d39] hover:bg-[#285751] text-white rounded-lg font-semibold transition-colors cursor-pointer\\\"\\n          >\\n            Cerrar\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AntigravityExportModal.tsx\", \"toolAction\":\"Updating AntigravityExportModal for single-file export\", \"toolSummary\":\"Update modal with single-file options\"}"
