      id: "call_403626"
      name: "create_file"
      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\n\\ninterface TherapeuticsScreenProps {\\n  onShowToast: (msg: string) => void;\\n  onOpenFhir: () => void;\\n}\\n\\nexport const TherapeuticsScreen: React.FC<TherapeuticsScreenProps> = ({\\n  onShowToast,\\n  onOpenFhir,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\'nutraceutical\' | \'lifestyle\' | \'gut5r\' | \'escalation\'>(\'nutraceutical\');\\n  const [checkedItems, setCheckedItems] = useState<Record<string, boolean>>({\\n    \'supp-1\': true,\\n    \'supp-2\': true,\\n    \'supp-3\': false,\\n    \'supp-4\': false,\\n    \'life-1\': true,\\n    \'life-2\': true,\\n  });\\n\\n  const toggleCheck = (id: string) => {\\n    setCheckedItems((prev) => ({ ...prev, [id]: !prev[id] }));\\n    onShowToast(\'Estado de intervenci\303\263n cl\303\255nica actualizado.\');\\n  };\\n\\n  return (\\n    <div className=\\\"flex flex-col w-full gap-6\\\">\\n      {/* Header Banner */}\\n      <section className=\\\"w-full bg-[#ffffff] rounded-xl p-5 md:p-6 shadow-sm border border-[#e9e1dd] flex flex-col md:flex-row md:items-center justify-between gap-4\\\">\\n        <div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"px-2 py-0.5 rounded bg-[#005c55]/10 text-[10px] font-bold text-[#005c55] uppercase tracking-wider\\\">\\n              PRESCRIPCI\303\223N INTEGRATIVA DIRIGIDA\\n            </span>\\n            <span className=\\\"text-[12px] text-[#6e7977]\\\">\\n              Protocolo: Reseteo Metab\303\263lico v3.2 \342\200\242 Fase 1 (Semanas 1-8)\\n            </span>\\n          </div>\\n          <h1 className=\\\"text-[22px] md:text-[24px] font-bold text-[#1e1b19] tracking-tight mt-1\\\">\\n            Matriz Terap\303\251utica Multimodal\\n          </h1>\\n          <p className=\\\"text-[13px] text-[#6e7977] max-w-2xl\\\">\\n            Sinergia biol\303\263gica entre fitoterapia de alta biodisponibilidad, restauraci\303\263n de la mucosa intestinal, crononutrici\303\263n y locomoci\303\263n biomec\303\241nica.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            onClick={() => onShowToast(\'Exportando plan terap\303\251utico detallado para la paciente...\')}\\n            className=\\\"px-4 py-2 rounded-lg bg-[#faf2ee] hover:bg-[#f4ece8] text-[12px] text-[#1e1b19] font-bold border border-[#e9e1dd] transition-colors cursor-pointer\\\"\\n          >\\n            Imprimir Gu\303\255a del Paciente\\n          </button>\\n          <button\\n            onClick={onOpenFhir}\\n            className=\\\"px-4 py-2 rounded-lg bg-[#005c55] hover:bg-[#0f766e] text-white text-[12px] font-bold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[16px]\\\">send_time_extension</span>\\n            <span>Firmar Prescripci\303\263n Electr\303\263nica</span>\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* Segmented Filter Bar */}\\n      <div className=\\\"flex items-center gap-2 border-b border-[#eee7e3] pb-2\\\">\\n        <button\\n          onClick={() => setActiveTab(\'nutraceutical\')}\\n          className={`px-3 py-1.5 rounded-lg text-[13px] font-semibold transition-colors cursor-pointer ${\\n            activeTab === \'nutraceutical\'\\n              ? \'bg-[#005c55] text-white shadow-sm\'\\n              : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n          }`}\\n        >\\n          Nutrac\303\251uticos y Fitosomas\\n        </button>\\n        <button\\n          onClick={() => setActiveTab(\'gut5r\')}\\n          className={`px-3 py-1.5 rounded-lg text-[13px] font-semibold transition-colors cursor-pointer ${\\n            activeTab === \'gut5r\'\\n              ? \'bg-[#005c55] text-white shadow-sm\'\\n              : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n          }`}\\n        >\\n          Protocolo 5R de Barrera Intestinal\\n        </button>\\n        <button\\n          onClick={() => setActiveTab(\'lifestyle\')}\\n          className={`px-3 py-1.5 rounded-lg text-[13px] font-semibold transition-colors cursor-pointer ${\\n            activeTab === \'lifestyle\'\\n              ? \'bg-[#005c55] text-white shadow-sm\'\\n              : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n          }`}\\n        >\\n          Crononutrici\303\263n y Ejercicio Zona 2\\n        </button>\\n        <button\\n          onClick={() => setActiveTab(\'escalation\')}\\n          className={`px-3 py-1.5 rounded-lg text-[13px] font-semibold transition-colors cursor-pointer ${\\n            activeTab === \'escalation\'\\n              ? \'bg-[#005c55] text-white shadow-sm\'\\n              : \'bg-[#faf2ee] text-[#3e4947] hover:bg-[#f4ece8]\'\\n          }`}\\n        >\\n          \303\201rbol de Escalamiento Farmacol\303\263gico\\n        </button>\\n      </div>\\n\\n      {/* Tab 1: Nutraceutical Schedule */}\\n      {activeTab === \'nutraceutical\' && (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n          {/* Card 1: Berberine Phytosome */}\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col justify-between\\\">\\n            <div>\\n              <div className=\\\"flex items-start justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-[10px] font-bold text-[#005c55] uppercase tracking-wider\\\">\\n                    Eje AMPK / Sensibilizador Insul\303\255nico\\n                  </span>\\n                  <h3 className=\\\"text-[16px] font-bold text-[#1e1b19] mt-0.5\\\">\\n                    Fitoma de Berberina Dirigido\\n                  </h3>\\n                </div>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={checkedItems[\'supp-1\']}\\n                  onChange={() => toggleCheck(\'supp-1\')}\\n                  className=\\\"w-5 h-5 text-[#005c55] rounded cursor-pointer accent-[#005c55]\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-2.5 my-3 rounded-lg bg-[#faf2ee] text-[12px] border border-[#eee7e3] space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Posolog\303\255a:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">500 mg BID (con almuerzo y cena)</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Formulaci\303\263n:</span>\\n                  <strong className=\\\"text-[#005c55]\\\">Fosfol\303\255pidos de girasol (10x absorci\303\263n)</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Mecanismo:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">Inhibe ChREBP y activa AMPK en miocito</strong>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"text-[12px] text-[#6e7977] leading-relaxed\\\">\\n                Reduce la gluconeog\303\251nesis hep\303\241tica de manera an\303\241loga a la metformina sin interferir en la cadena mitocondrial compleja I cuando se usa en forma de fitosoma.\\n              </p>\\n            </div>\\n            <div className=\\\"mt-4 pt-2 border-t border-[#eee7e3] text-[11px] text-[#904d00] font-semibold flex items-center gap-1\\\">\\n              <span className=\\\"material-symbols-outlined text-[14px]\\\">timer</span>\\n              <span>Duraci\303\263n prescrita: 8 semanas continuas (Revisar en control HOMA)</span>\\n            </div>\\n          </div>\\n\\n          {/* Card 2: Inositol Ratio */}\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col justify-between\\\">\\n            <div>\\n              <div className=\\\"flex items-start justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-[10px] font-bold text-[#005c55] uppercase tracking-wider\\\">\\n                    Segundo Mensajero Intracelular\\n                  </span>\\n                  <h3 className=\\\"text-[16px] font-bold text-[#1e1b19] mt-0.5\\\">\\n                    Mio-Inositol + D-Quiro-Inositol (40:1)\\n                  </h3>\\n                </div>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={checkedItems[\'supp-2\']}\\n                  onChange={() => toggleCheck(\'supp-2\')}\\n                  className=\\\"w-5 h-5 text-[#005c55] rounded cursor-pointer accent-[#005c55]\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-2.5 my-3 rounded-lg bg-[#faf2ee] text-[12px] border border-[#eee7e3] space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Posolog\303\255a:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">2.000 mg en ayunas diluido en agua</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Ratio Can\303\263nico:</span>\\n                  <strong className=\\\"text-[#005c55]\\\">40:1 Fisiol\303\263gico de tejido ov\303\241rico y muscular</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Mecanismo:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">Mediador inositolglicano IPG fosfodiesterasa</strong>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"text-[12px] text-[#6e7977] leading-relaxed\\\">\\n                Restaura el acoplamiento post-receptor de la insulina. Ideal para el fenotipo de Eleanor con antecedentes de diabetes gestacional y adiposidad ov\303\241rica/visceral.\\n              </p>\\n            </div>\\n            <div className=\\\"mt-4 pt-2 border-t border-[#eee7e3] text-[11px] text-[#005c55] font-semibold flex items-center gap-1\\\">\\n              <span className=\\\"material-symbols-outlined text-[14px]\\\">check_circle</span>\\n              <span>Tolerancia g\303\241strica \303\263ptima, sin efectos secundarios descritos</span>\\n            </div>\\n          </div>\\n\\n          {/* Card 3: Trans-Resveratrol Micronizado */}\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col justify-between\\\">\\n            <div>\\n              <div className=\\\"flex items-start justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-[10px] font-bold text-[#904d00] uppercase tracking-wider\\\">\\n                    Activador de Sirtuinas / Mitocondria\\n                  </span>\\n                  <h3 className=\\\"text-[16px] font-bold text-[#1e1b19] mt-0.5\\\">\\n                    Trans-Resveratrol Micronizado + Quercetina\\n                  </h3>\\n                </div>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={checkedItems[\'supp-3\']}\\n                  onChange={() => toggleCheck(\'supp-3\')}\\n                  className=\\\"w-5 h-5 text-[#005c55] rounded cursor-pointer accent-[#005c55]\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-2.5 my-3 rounded-lg bg-[#faf2ee] text-[12px] border border-[#eee7e3] space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Posolog\303\255a:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">250 mg trans-resveratrol + 150 mg quercetina</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Momento:</span>\\n                  <strong className=\\\"text-[#904d00]\\\">Con el desayuno con grasas saludables</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Mecanismo:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">Activaci\303\263n de SIRT1 y desacetilaci\303\263n de PGC-1\316\261</strong>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"text-[12px] text-[#6e7977] leading-relaxed\\\">\\n                Estimula la biog\303\251nesis mitocondrial en m\303\272sculo esquel\303\251tico, atenuando la toxicidad de l\303\255pidos intramiocelulares que bloquean la v\303\255a PI3K/Akt.\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Card 4: Sulforaphane Glucosinolate */}\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col justify-between\\\">\\n            <div>\\n              <div className=\\\"flex items-start justify-between\\\">\\n                <div>\\n                  <span className=\\\"text-[10px] font-bold text-[#005c55] uppercase tracking-wider\\\">\\n                    Eje Nrf2 / Detox Hep\303\241tica\\n                  </span>\\n                  <h3 className=\\\"text-[16px] font-bold text-[#1e1b19] mt-0.5\\\">\\n                    Sulforafano Estandarizado (BrocColina)\\n                  </h3>\\n                </div>\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={checkedItems[\'supp-4\']}\\n                  onChange={() => toggleCheck(\'supp-4\')}\\n                  className=\\\"w-5 h-5 text-[#005c55] rounded cursor-pointer accent-[#005c55]\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-2.5 my-3 rounded-lg bg-[#faf2ee] text-[12px] border border-[#eee7e3] space-y-1\\\">\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Posolog\303\255a:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">60 mg glucorafanina + mirosinasa activa</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Objetivo:</span>\\n                  <strong className=\\\"text-[#005c55]\\\">Reducci\303\263n de esteatosis hep\303\241tica (FLI 64.8)</strong>\\n                </div>\\n                <div className=\\\"flex justify-between\\\">\\n                  <span className=\\\"text-[#6e7977]\\\">Mecanismo:</span>\\n                  <strong className=\\\"text-[#1e1b19]\\\">Inducci\303\263n de glutati\303\263n y fase II hep\303\241tica</strong>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"text-[12px] text-[#6e7977] leading-relaxed\\\">\\n                Revierte la acumulaci\303\263n de sn-1,2-diacilglicerol en hepatocitos, liberando la inhibici\303\263n mediada por PKC\316\265 sobre el receptor de insulina.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Tab 2: Gut 5R Protocol */}\\n      {activeTab === \'gut5r\' && (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-5 gap-3\\\">\\n          <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col\\\">\\n            <span className=\\\"text-[11px] font-bold text-[#cb2044] uppercase\\\">1. Remove (Remover)</span>\\n            <h4 className=\\\"text-[14px] font-bold text-[#1e1b19] mt-1\\\">Eliminaci\303\263n de Gatillos</h4>\\n            <p className=\\\"text-[11.5px] text-[#6e7977] mt-2 leading-relaxed\\\">\\n              Excluir gluten, case\303\255na A1, aceites de semillas industriales y jarabe de ma\303\255z alto en fructosa para suprimir est\303\255mulo de zonulina.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col\\\">\\n            <span className=\\\"text-[11px] font-bold text-[#fe932c] uppercase\\\">2. Replace (Reemplazar)</span>\\n            <h4 className=\\\"text-[14px] font-bold text-[#1e1b19] mt-1\\\">Soporte Digestivo</h4>\\n            <p className=\\\"text-[11.5px] text-[#6e7977] mt-2 leading-relaxed\\\">\\n              Enzimas pancre\303\241ticas de espectro completo con lipasa concentrada y sales biliares antes de comidas principales para asegurar degradaci\303\263n lip\303\255dica.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col\\\">\\n            <span className=\\\"text-[11px] font-bold text-[#005c55] uppercase\\\">3. Reinoculate (Reinocular)</span>\\n            <h4 className=\\\"text-[14px] font-bold text-[#1e1b19] mt-1\\\">Akkermansia & SCFA</h4>\\n            <p className=\\\"text-[11.5px] text-[#6e7977] mt-2 leading-relaxed\\\">\\n              Akkermansia muciniphila pasteurizada + polifenoles de granada y ar\303\241ndano para restaurar la capa mucosa intestinal protectora.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col\\\">\\n            <span className=\\\"text-[11px] font-bold text-[#005c55] uppercase\\\">4. Repair (Reparar)</span>\\n            <h4 className=\\\"text-[14px] font-bold text-[#1e1b19] mt-1\\\">Sello Epitelial</h4>\\n            <p className=\\\"text-[11.5px] text-[#6e7977] mt-2 leading-relaxed\\\">\\n              L-Glutamina 5g BID, Zinc Carnosina 75mg BID e Inmunoglobulinas de suero bovino (SBI) para neutralizar endotoxina bacteriana (LPS).\\n            </p>\\n          </div>\\n\\n          <div className=\\\"bg-[#ffffff] p-4 rounded-xl shadow-sm border border-[#e9e1dd] flex flex-col\\\">\\n            <span className=\\\"text-[11px] font-bold text-[#904d00] uppercase\\\">5. Rebalance (Rebalancear)</span>\\n            <h4 className=\\\"text-[14px] font-bold text-[#1e1b19] mt-1\\\">Eje Cerebro-Intestino</h4>\\n            <p className=\\\"text-[11.5px] text-[#6e7977] mt-2 leading-relaxed\\\">\\n              Estimulaci\303\263n del nervio vago: g\303\241rgaras matutinas, respiraci\303\263n diafragm\303\241tica 4-7-8 pre-comida y optimizaci\303\263n del ritmo circadiano.\\n            </p>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Tab 3: Lifestyle & Zone 2 */}\\n      {activeTab === \'lifestyle\' && (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd]\\\">\\n            <div className=\\\"flex items-center gap-2 text-[#005c55] mb-2\\\">\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">directions_walk</span>\\n              <h3 className=\\\"text-[15px] font-bold text-[#1e1b19]\\\">\\n                Locomoci\303\263n Postprandial Cronometrada\\n              </h3>\\n            </div>\\n            <div className=\\\"space-y-2 text-[12.5px] text-[#3e4947] leading-relaxed\\\">\\n              <p>\\n                <strong>Prescripci\303\263n:</strong> Caminata en\303\251rgica de 15 a 20 minutos dentro de los 30 minutos posteriores al almuerzo y la cena.\\n              </p>\\n              <p>\\n                <strong>Mecanismo biol\303\263gico:</strong> La contracci\303\263n isom\303\251trica e isot\303\263nica del s\303\263leo y cu\303\241driceps transloca transportadores GLUT4 de manera independiente de la insulina, reduciendo el pico gluc\303\251mico en hasta un 35% y desahogando al p\303\241ncreas.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd]\\\">\\n            <div className=\\\"flex items-center gap-2 text-[#904d00] mb-2\\\">\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">fitness_center</span>\\n              <h3 className=\\\"text-[15px] font-bold text-[#1e1b19]\\\">\\n                Entrenamiento en Zona 2 y Fuerza Progresiva\\n              </h3>\\n            </div>\\n            <div className=\\\"space-y-2 text-[12.5px] text-[#3e4947] leading-relaxed\\\">\\n              <p>\\n                <strong>Prescripci\303\263n:</strong> 150 minutos semanales de ejercicio aer\303\263bico estricto en Zona 2 (frecuencia card\303\255aca ~115\342\200\223128 lpm para Eleanor) + 2 sesiones de fuerza con sobrecarga progresiva.\\n              </p>\\n              <p>\\n                <strong>Mecanismo biol\303\263gico:</strong> Maximiza la densidad mitocondrial y la tasa de oxidaci\303\263n de \303\241cidos grasos (FatMax), consumiendo diacilgliceroles intramiocelulares y ampliando el sumidero gluc\303\255dico.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Tab 4: Escalation Tree */}\\n      {activeTab === \'escalation\' && (\\n        <div className=\\\"bg-[#ffffff] p-5 rounded-xl shadow-sm border border-[#e9e1dd]\\\">\\n          <h3 className=\\\"text-[15px] font-bold text-[#1e1b19] mb-3\\\">\\n            Algoritmo de Escalamiento Escalonado (CDSS)\\n          </h3>\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"p-3 rounded-lg bg-[#005c55]/10 border border-[#005c55]/20 flex items-start gap-3\\\">\\n              <span className=\\\"px-2 py-0.5 rounded bg-[#005c55] text-white text-[11px] font-bold\\\">\\n                Nivel 1 (Actual)\\n              </span>\\n              <p className=\\\"text-[12px] text-[#1e1b19]\\\">\\n                <strong>Fitoma de Berberina 500mg BID + Inositol + Zona 2:</strong> Monitoreo por 8 semanas con MCG telem\303\251trico continuo. Meta: HOMA-IR &lt; 2.50 y CV de glucosa &lt; 20%.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-3 rounded-lg bg-[#fe932c]/10 border border-[#fe932c]/20 flex items-start gap-3\\\">\\n              <span className=\\\"px-2 py-0.5 rounded bg-[#fe932c] text-white text-[11px] font-bold\\\">\\n                Nivel 2 (Si HOMA &gt; 2.5 a Semana 12)\\n              </span>\\n              <p className=\\\"text-[12px] text-[#1e1b19]\\\">\\n                <strong>Metformina de Liberaci\303\263n Prolongada 500-1000mg + P\303\251ptidos GLP-1 microdosificados:</strong> Evaluaci\303\263n previa de TFGe y Cistatina C. Monitoreo estricto de vitamina B12.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"p-3 rounded-lg bg-[#cb2044]/10 border border-[#cb2044]/20 flex items-start gap-3\\\">\\n              <span className=\\\"px-2 py-0.5 rounded bg-[#cb2044] text-white text-[11px] font-bold\\\">\\n                Nivel 3 (Falla a Estrato 3)\\n              </span>\\n              <p className=\\\"text-[12px] text-[#1e1b19]\\\">\\n                <strong>Agonistas duales GIP/GLP-1 (Tirzepatida) + Inhibidores de SGLT-2:</strong> Reservado para glucosa sostenida &gt;130 mg/dL o da\303\261o org\303\241nico subcl\303\255nico evidente.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/screens/TherapeuticsScreen.tsx\", \"toolAction\":\"Creating TherapeuticsScreen.tsx\", \"toolSummary\":\"Create Matriz Terap\303\251utica screen\"}"
      thought_signature: ""
      original_name: "create_file"
    }
    thinking_duration {
      seconds: 16
      nanos: 724086640
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "mDXEaozDFZ77qtsP9ZLSmAo"
  }
}
