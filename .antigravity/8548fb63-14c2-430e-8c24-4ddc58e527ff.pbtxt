  view_file {
    absolute_path_uri: "file:///src/components/Sidebar.tsx"
    end_line: 44
    content: "import React from \'react\';\nimport { PatientLabs } from \'../types\';\n\ninterface SidebarProps {\n  labs: PatientLabs;\n  homaIr?: number;\n  stratumName?: string;\n  stratumStatus?: string;\n  onOpenFhir?: () => void;\n  onOpenGame?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  labs,\n  homaIr = 3.59,\n  stratumName = \'Estrato 2\',\n  stratumStatus = \'Fricci\303\263n Moderada\',\n  onOpenFhir,\n  onOpenGame,\n}) => {\n  const trigHdlRatio = Number((labs.triglycerides / Math.max(1, labs.hdl)).toFixed(2));\n\n  return (\n    <aside className=\"fixed left-0 top-[152px] bottom-0 w-64 bg-[#faf2ee] shadow-[1px_0_8px_rgba(0,0,0,0.02)] border-r border-[#e9e1dd] z-40 hidden xl:flex flex-col justify-between p-4 overflow-y-auto no-scrollbar\">\n      <div className=\"flex flex-col gap-4\">\n        {/* Header Ribbon */}\n        <div className=\"flex items-center justify-between px-1\">\n          <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#6e7977]\">\n            TRIAJE Y COHORTE\n          </span>\n          <span className=\"material-symbols-outlined text-[16px] text-[#6e7977]\">\n            vital_signs\n          </span>\n        </div>\n\n        {/* Stratum Card */}\n        <div className=\"p-3 rounded-lg bg-[#ffffff] shadow-[0_1px_3px_rgba(0,0,0,0.02)] border border-[#e9e1dd] flex flex-col gap-1\">\n          <span className=\"text-[11px] text-[#6e7977]\">Estrato de Riesgo Metab\303\263lico</span>\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[16px] text-[#904d00] font-bold\">{stratumName}</span>\n            <span className=\"text-[11px] px-1.5 py-0.5 rounded bg-[#f4ece8] text-[#904d00] font-semibold\">\n              {stratumStatus}\n            </span>\n          </div>\n          <div className=\"w-full bg-[#eee7e3] h-1.5 rounded-full overflow-hidden mt-1\">"
    raw_content: "import React from \'react\';\nimport { PatientLabs } from \'../types\';\n\ninterface SidebarProps {\n  labs: PatientLabs;\n  homaIr?: number;\n  stratumName?: string;\n  stratumStatus?: string;\n  onOpenFhir?: () => void;\n  onOpenGame?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  labs,\n  homaIr = 3.59,\n  stratumName = \'Estrato 2\',\n  stratumStatus = \'Fricci\303\263n Moderada\',\n  onOpenFhir,\n  onOpenGame,\n}) => {\n  const trigHdlRatio = Number((labs.triglycerides / Math.max(1, labs.hdl)).toFixed(2));\n\n  return (\n    <aside className=\"fixed left-0 top-[152px] bottom-0 w-64 bg-[#faf2ee] shadow-[1px_0_8px_rgba(0,0,0,0.02)] border-r border-[#e9e1dd] z-40 hidden xl:flex flex-col justify-between p-4 overflow-y-auto no-scrollbar\">\n      <div className=\"flex flex-col gap-4\">\n        {/* Header Ribbon */}\n        <div className=\"flex items-center justify-between px-1\">\n          <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#6e7977]\">\n            TRIAJE Y COHORTE\n          </span>\n          <span className=\"material-symbols-outlined text-[16px] text-[#6e7977]\">\n            vital_signs\n          </span>\n        </div>\n\n        {/* Stratum Card */}\n        <div className=\"p-3 rounded-lg bg-[#ffffff] shadow-[0_1px_3px_rgba(0,0,0,0.02)] border border-[#e9e1dd] flex flex-col gap-1\">\n          <span className=\"text-[11px] text-[#6e7977]\">Estrato de Riesgo Metab\303\263lico</span>\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[16px] text-[#904d00] font-bold\">{stratumName}</span>\n            <span className=\"text-[11px] px-1.5 py-0.5 rounded bg-[#f4ece8] text-[#904d00] font-semibold\">\n              {stratumStatus}\n            </span>\n          </div>\n          <div className=\"w-full bg-[#eee7e3] h-1.5 rounded-full overflow-hidden mt-1\">\n            <div className=\"bg-[#fe932c] h-full w-[65%] rounded-full transition-all duration-500\" />\n          </div>\n        </div>\n\n        {/* Vital Parameters Card */}\n        <div className=\"p-3 rounded-lg bg-[#ffffff] shadow-[0_1px_3px_rgba(0,0,0,0.02)] border border-[#e9e1dd] flex flex-col gap-2\">\n          <span className=\"text-[11px] font-semibold text-[#6e7977]\">Par\303\241metros Vitales</span>\n\n          <div className=\"flex justify-between text-[12px]\">\n            <span className=\"text-[#3e4947]\">Insulina Basal:</span>\n            <span className=\"font-semibold text-[#904d00] tabular-nums\">\n              {labs.insulinFasting} \316\274IU/mL\n            </span>\n          </div>\n\n          <div className=\"flex justify-between text-[12px]\">\n            <span className=\"text-[#3e4947]\">Glucosa Basal:</span>\n            <span className=\"font-semibold text-[#1e1b19] tabular-nums\">\n              {labs.glucoseFasting} mg/dL\n            </span>\n          </div>\n\n          <div className=\"flex justify-between text-[12px]\">\n            <span className=\"text-[#3e4947]\">HOMA-IR:</span>\n            <span className=\"font-semibold text-[#904d00] tabular-nums\">\n              {homaIr} (Alto)\n            </span>\n          </div>\n\n          <div className=\"flex justify-between text-[12px]\">\n            <span className=\"text-[#3e4947]\">Ratio Trig/HDL:</span>\n            <span className=\"font-semibold text-[#904d00] tabular-nums\">\n              {trigHdlRatio}\n            </span>\n          </div>\n        </div>\n\n        {/* Active Interventions Card */}\n        <div className=\"p-3 rounded-lg bg-[#ffffff] shadow-[0_1px_3px_rgba(0,0,0,0.02)] border border-[#e9e1dd] flex flex-col gap-1\">\n          <span className=\"text-[11px] font-semibold text-[#6e7977]\">Intervenciones Activas</span>\n          <span className=\"text-[13px] font-medium text-[#005c55]\">\n            Fitoma de Berberina Dirigido\n          </span>\n          <span className=\"text-[11px] text-[#6e7977]\">\n            500mg BID con comidas \342\200\242 D\303\255a 18\n          </span>\n        </div>\n\n        {/* Clinical Challenge Teaser Banner */}\n        <div\n          onClick={onOpenGame}\n          className=\"p-3 rounded-lg bg-gradient-to-br from-[#fe932c]/15 via-[#fe932c]/5 to-transparent border border-[#fe932c]/30 cursor-pointer hover:border-[#fe932c] transition-all group\"\n        >\n          <div className=\"flex items-center gap-1.5 text-[#904d00] font-bold text-[12px] mb-1\">\n            <span className=\"material-symbols-outlined text-[16px] text-[#fe932c] group-hover:rotate-12 transition-transform\">\n              trophy\n            </span>\n            <span>Simulador de 10 Niveles</span>\n          </div>\n          <p className=\"text-[11px] text-[#6e7977] leading-tight\">\n            Prueba tu pericia cl\303\255nica diagnosticando 10 casos progresivos con curvas Kraft y fenotipos ATM.\n          </p>\n          <div className=\"mt-2 text-[11px] font-semibold text-[#005c55] flex items-center gap-1\">\n            <span>Iniciar Reto</span>\n            <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n          </div>\n        </div>\n      </div>\n\n      {/* FHIR Connection Footer */}\n      <div className=\"p-2 text-[11px] text-[#6e7977] flex flex-col gap-1 border-t border-[#e9e1dd] pt-3\">\n        <button\n          onClick={onOpenFhir}\n          className=\"flex items-center gap-1 text-[#005c55] font-semibold hover:underline text-left cursor-pointer\"\n        >\n          <span className=\"material-symbols-outlined text-[15px] animate-spin\">sync</span>\n          <span>HL7 FHIR R4 Conectado</span>\n        </button>\n        <span className=\"text-[10px] text-[#6e7977]\">Servidor: us-east-clinical.fhir</span>\n      </div>\n    </aside>\n  );\n};\n"
    num_lines: 129
    num_bytes: 5554
  }
}
