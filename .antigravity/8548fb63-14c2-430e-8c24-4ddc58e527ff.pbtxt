          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        prompt: \'\302\277Qu\303\251 est\303\255mulo de ejercicio activa la translocaci\303\263n de GLUT4 sin requerir uni\303\263n de insulina al receptor?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'La contracci\303\263n muscular repetida que activa la quinasa dependiente de Calcio/Calmodulina (CaMKII) y la prote\303\255na quinasa activada por AMP (AMPK).\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            correct: true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            explanation: \'Excelente: Este es el mecanismo fisiol\303\263gico por el cual el ejercicio rompe el bloqueo del receptor insul\303\255nico fosforilado en serina.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text: \'El reposo absoluto en cama con elevaci\303\263n de piernas.\',"
